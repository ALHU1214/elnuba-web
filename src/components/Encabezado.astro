---
import { ruta } from '../lib/ruta';
// Cabecera de las páginas interiores. Estilo "Escaparate" (9-nov-2026): mosaico con un bloque marino (miga de pan,
// título, entradilla y botones) y, al lado, una foto grande o lo que se pase en el hueco "lateral".
import { telHref, negocio, correos, type TipoCorreo } from '../data/negocio';
import CopiarCorreo from './CopiarCorreo.astro';
import Marcas from './Marcas.astro';

// fecha (AAAA-MM-DD): si la entradilla es una fecha (legales), va dentro de <time> para que buscadores e IA la lean bien
interface Props { antetitulo: string; titulo: string; entradilla: string; miga: string; botones?: boolean; foto?: string; fotoAlt?: string; correo?: TipoCorreo; marcas?: boolean; fecha?: string; }
const { antetitulo, titulo, entradilla, miga, botones = true, foto, fotoAlt = '', correo = 'general', marcas = true, fecha } = Astro.props;
const lateral = Astro.slots.has('lateral'); // algo a la derecha en lugar de foto (p. ej. la tarjeta de los años)
// 16-nov-2026: algo dentro del mismo bloque marino, a la derecha del título (abajo en el móvil). Contacto: teléfono y correo
const dentro = Astro.slots.has('dentro');
const conLado = Boolean(foto || lateral);
// 15-nov-2026: en el móvil, los títulos largos (Empresas: 6 líneas) van algo más pequeños para que la cabecera quepa en la pantalla
const tituloLargo = titulo.length > 65;

const migaJsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(ruta('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: miga, item: new URL(Astro.url.pathname, Astro.site).href },
  ],
};
---
{/* 15-nov-2026 (Álvaro): con marcas y algo al lado (Colegios, Empresas, Nosotros), en el ordenador la cabecera mide lo
     que deja la ventana para que lo último que se vea sea la franja de marcas y un poco de fondo. CSS: .cabecera-interior */}
<section class:list={['mx-auto max-w-7xl px-3 pt-3 sm:px-4 md:px-6 md:pt-5', marcas && conLado && 'cabecera-interior']}>
  <div class:list={['grid gap-3 md:gap-4', conLado && 'lg:grid-cols-12']}>
    <div class:list={['zona-oscura relative overflow-hidden rounded-[2rem] p-7 sm:p-10 lg:p-12', dentro ? 'grid gap-8 sm:gap-10 lg:grid-cols-12 lg:items-center lg:gap-0' : 'flex flex-col justify-center', conLado && 'lg:col-span-7']}>
      <div class:list={['entra', dentro && 'min-w-0 lg:col-span-7 lg:pr-12']}>
        <nav aria-label="Estás aquí" class="text-sm text-tinta/70">
          <a href={ruta('/')} class="hover:text-tinta hover:underline">Inicio</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span aria-current="page" class="text-tinta">{miga}</span>
        </nav>
        <p class="antetitulo mt-5 text-xs sm:mt-7 font-bold tracking-[.2em] uppercase">{antetitulo}</p>
        <h1 class:list={['mt-4 max-w-3xl leading-[1.04] sm:mt-5 sm:text-5xl lg:text-[3.3rem]', tituloLargo ? 'text-[clamp(1.8rem,8.4vw,2.05rem)]' : 'text-[clamp(2.1rem,9.6vw,2.4rem)]']}>{titulo}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-tinta/75">{fecha ? <time datetime={fecha}>{entradilla}</time> : entradilla}</p>
        {botones && (
          <>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">{/* wrap: a 1024-1279 px no caben los dos (13-nov) */}
              <a href={correos[correo]} class="btn-primario">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                Pedir presupuesto por correo
              </a>
              <a href={telHref} class="btn-secundario">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
                Llamar al {negocio.telefono}
              </a>
            </div>
            <CopiarCorreo class="mt-4" />
          </>
        )}
      </div>
      {dentro && <div class="entra-tarde min-w-0 border-t border-linea pt-8 sm:pt-10 lg:col-span-5 lg:border-t-0 lg:border-l lg:py-2 lg:pl-12"><slot name="dentro" /></div>}
    </div>
    {lateral && <div class="entra-tarde lg:col-span-5"><slot name="lateral" /></div>}
    {foto && (
      <figure class="entra-tarde relative aspect-[16/10] overflow-hidden rounded-[2rem] lg:col-span-5 lg:aspect-auto lg:min-h-[22rem]">
        <img src={ruta(foto)} alt={fotoAlt} width="960" height="720" loading="eager" decoding="async" class="absolute inset-0 size-full object-cover" />
      </figure>
    )}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(migaJsonld)} />
</section>
{marcas && <Marcas />}
