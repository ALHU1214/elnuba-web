---
// Bloque del final de cada página: pedir presupuesto.
// Acción principal igual en toda la web: pedir presupuesto por correo (ya escrito según la página); llamar va al lado;
// debajo, la dirección con botón de copiar. Estilo "Escaparate" (9-nov-2026): bloque marino con el lápiz del logo dibujado.
import { negocio, telHref, correos, type TipoCorreo } from '../data/negocio';
import CopiarCorreo from './CopiarCorreo.astro';

interface Props { titulo?: string; texto?: string; correo?: TipoCorreo; }
const {
  titulo = '¿Necesitas un presupuesto?',
  texto = 'Mándanos tu lista de material y te preparamos el presupuesto.',
  correo = 'general',
} = Astro.props;
---
<section class="mx-auto max-w-7xl px-3 pb-10 sm:px-4 md:px-6 md:pb-20">
  <div data-revelar-bloque class="zona-oscura relative isolate overflow-hidden rounded-[2rem] p-8 sm:p-10 md:p-14">
    {/* El lápiz del logo como dibujo: tres franjas en diagonal */}
    <div aria-hidden="true" class="franjas pointer-events-none absolute -right-28 -bottom-8 -z-10 hidden h-20 w-[30rem] -rotate-[20deg] rounded-full opacity-90 md:block"></div>
    <div class="max-w-2xl">
      <p class="antetitulo text-xs font-bold tracking-[.2em] uppercase">Contacto</p>
      <h2 class="mt-4 text-4xl md:text-5xl">{titulo}</h2>
      <p class="mt-4 text-lg text-tinta/75">{texto}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={correos[correo]} class="btn-primario">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          Pedir presupuesto por correo
        </a>
        <a href={telHref} class="btn-secundario">Llamar al {negocio.telefono}</a>
      </div>
      <CopiarCorreo class="mt-4" />
    </div>
  </div>
</section>
