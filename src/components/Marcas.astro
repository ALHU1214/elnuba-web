---
import { ruta } from '../lib/ruta';
// Banner de marcas (9-nov-2026, CRO): la prueba de que tienen lo que el cliente ya usa. Va justo después de la portada
// del inicio y de la cabecera de Colegios y Empresas (16-nov-2026: en Nosotros y en Contacto ya no va). Franja blanca de lado a lado (Álvaro: "falta
// el banner con las marcas" cuando quedó como un bloque redondeado más). Logos a color que pasan solos; se paran al
// pasar el ratón y con "reducir movimiento".
import { marcas } from '../data/catalogo';
---
{marcas.length > 0 && (
<section aria-labelledby="marcas-titulo" class="franja-marcas mt-3 border-y border-linea bg-white py-6 md:mt-4 md:py-8">
  <p id="marcas-titulo" class="px-4 text-center text-xs font-bold tracking-[.2em] text-gris uppercase">Trabajamos con las mejores marcas</p>
  <div class="marcas-pista group relative mt-5 overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)] md:mt-6">
    <ul class="marcas-cinta flex w-max items-center gap-12 group-hover:[animation-play-state:paused] md:gap-16">
      {[...marcas, ...marcas].map((m, i) => (
        <li aria-hidden={i >= marcas.length ? 'true' : undefined}>
          <img src={ruta(`/marcas/${m.archivo}`)} alt={m.nombre} width={m.ancho} height={m.alto} loading="lazy" decoding="async" style={`--alto:${m.alto}px`} class="marca-logo w-auto object-contain" />
        </li>
      ))}
    </ul>
  </div>
</section>
)}
