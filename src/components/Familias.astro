---
// Lo que distribuyen (todas las familias o las de un tipo de cliente), como información: sin enlaces, porque no hay catálogo
// (9-nov-2026: el cliente no lo va a pasar). Etiquetas con icono que se reparten solas en filas, sin huecos, y debajo una
// franja propia "¿Buscas algo concreto?" con los botones de preguntar por correo y de llamar.
import { familias } from '../data/catalogo';
import { correos, telHref, negocio } from '../data/negocio';
import IconoFamilia from './IconoFamilia.astro';

interface Props { para?: 'colegios' | 'empresas'; sobreBlanco?: boolean; }
const { para, sobreBlanco = false } = Astro.props;
const lista = para ? familias.filter((f) => f.para.includes(para)) : familias;
---
<ul class="flex flex-wrap gap-2.5 md:gap-3">
  {lista.map((f) => (
    <li class:list={['flex items-center gap-3 rounded-full py-2 pr-5 pl-2 font-display font-semibold md:text-[17px]', sobreBlanco ? 'bg-papel' : 'bloque']}>
      <span class="icono-tile grid size-10 shrink-0 place-items-center rounded-full"><IconoFamilia slug={f.slug} /></span>
      {f.nombre}
    </li>
  ))}
</ul>

<div class="zona-oscura mt-6 flex flex-col gap-6 rounded-[1.75rem] p-6 sm:p-8 md:mt-8 lg:flex-row lg:items-center lg:justify-between">
  <div class="flex items-start gap-4">
    <span class="grid size-12 shrink-0 place-items-center rounded-full bg-white/10 text-naranja">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current stroke-2 [stroke-linecap:round]"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    </span>
    <div>
      <p class="font-display text-xl font-bold md:text-2xl">¿Buscas algo concreto?</p>
      <p class="mt-1 text-tinta/75">Pregúntanos y te decimos si lo tenemos.</p>
    </div>
  </div>
  <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
    <a href={correos.articulo} class="btn-primario">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
      Preguntar por correo
    </a>
    <a href={telHref} class="btn-secundario">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
      Llamar al {negocio.telefono}
    </a>
  </div>
</div>
