---
// Lo que distribuyen, como un cuaderno de anillas (10-nov-2026, Álvaro: le gusta el cuaderno pero "muy básico").
// Índice por grupos en columnas, cada familia en su renglón; sin enlaces, porque no hay catálogo (9-nov-2026).
// Al final, "¿Buscas algo concreto?" con preguntar por correo y llamar. Lleva su propio bloque (el cuaderno),
// así sale igual en el inicio, en Colegios y en Empresas.
import { familias, grupos } from '../data/catalogo';
import { correos, telHref, negocio } from '../data/negocio';
import IconoFamilia from './IconoFamilia.astro';

interface Props { antetitulo: string; titulo: string; texto?: string; para?: 'colegios' | 'empresas'; }
const { antetitulo, titulo, texto = 'Todo lo que te podemos servir, ordenado por familias.', para } = Astro.props;
const lista = para ? familias.filter((f) => f.para.includes(para)) : familias;
const columnas = grupos
  .map((g) => {
    const deEste = lista.filter((f) => f.grupo === g.id);
    const junto = g.partes ? deEste.map((f) => g.partes![f.slug]).join(' y ') : g.nombre;
    const nombre = junto.charAt(0).toUpperCase() + junto.slice(1).toLowerCase(); // "Arte y regalo"
    return { ...g, nombre, familias: deEste };
  })
  .filter((g) => g.familias.length > 0);
---
<div class="bloque cuaderno px-6 pb-6 sm:px-8 sm:pb-8 md:px-12 md:pb-12">
  <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="antetitulo text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">{antetitulo}</p>
      <h2 class="mt-3 text-4xl md:text-5xl">{titulo}</h2>
    </div>
    <p class="max-w-xs leading-relaxed text-gris md:pb-1 md:text-right">{texto}</p>
  </div>

  <div class="indice mt-10 md:mt-12" style={`--cols:${columnas.length}`}>
    {columnas.map((g) => (
      <div>
        <h3 class="border-b-2 border-tinta pb-3 text-xs font-bold text-naranja-oscuro uppercase">{g.nombre}</h3>
        <ul>
          {g.familias.map((f) => (
            <li class="flex min-h-14 items-center gap-3 border-b border-linea py-2 font-semibold leading-snug">
              <span class="icono-tile grid size-9 shrink-0 place-items-center rounded-full"><IconoFamilia slug={f.slug} class="size-[18px]" /></span>
              {f.nombre}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="mt-10 flex flex-col gap-5 rounded-3xl bg-papel p-5 sm:p-6 md:mt-12 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex items-start gap-4">
      <span class="grid size-12 shrink-0 place-items-center rounded-full bg-white text-naranja-oscuro">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current stroke-2 [stroke-linecap:round]"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </span>
      <div>
        <p class="text-lg font-bold md:text-xl">¿Buscas algo concreto?</p>
        <p class="mt-0.5 text-gris">Pregúntanos y te decimos si lo tenemos.</p>
      </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
      <a href={correos.articulo} class="btn-primario">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        Preguntar por correo
      </a>
      <a href={telHref} class="btn-secundario">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
        Llamar al {negocio.telefono}
      </a>
    </div>
  </div>
</div>
