---
// Lo que distribuyen, dentro del cuaderno de anillas (10-nov-2026). Sin enlaces, porque no hay catálogo (9-nov-2026).
// 17-nov-2026: "el directorio" (Álvaro eligió la propuesta A entre tres, tras el máster). Una fila por familia: el
// nombre con su icono a la izquierda y sus artículos seguidos a la derecha, como el directorio de planta de unos grandes
// almacenes. Todo a la vista, sin pulsar nada. Al verse, las filas entran una detrás de otra y los iconos se dibujan
// solos (data-al-ver, Efectos.astro); sin JavaScript o con "reducir movimiento", todo dibujado desde el principio.
// Cada página lleva sus familias y en su orden (catalogo.ts): Colegios, lo escolar delante; Empresas, papel y tóner.
// Antes: tres columnas con los artículos en renglones (15 y 16-nov); antes aún, columnas por grupo con iconos en círculos.
// Al final, "¿No ves lo que buscas?" (BuscasAlgo.astro): deja claro que es solo una muestra.
// Lleva su propio bloque, así sale igual en el inicio, en Colegios y en Empresas.
import { familiasPara } from '../data/catalogo';
import IconoFamilia from './IconoFamilia.astro';
import BuscasAlgo from './BuscasAlgo.astro';

interface Props { antetitulo: string; titulo: string; para?: 'colegios' | 'empresas'; }
const { antetitulo, titulo, para } = Astro.props;
const lista = familiasPara(para);
---
<div class="bloque cuaderno px-6 pb-6 sm:px-8 sm:pb-8 md:px-12 md:pb-12">
  <div>
    <p class="antetitulo text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">{antetitulo}</p>
    <h2 class="mt-3 text-4xl md:text-5xl">{titulo}</h2>
  </div>

  <ul class="familias mt-9 md:mt-12" data-al-ver>
    {lista.map((f, n) => (
      <li class="familia" style={`--n:${n}`}>
        <h3 class="familia-cabeza">
          <IconoFamilia slug={f.icono} dibujar class="familia-icono" />
          {f.nombre}
        </h3>
        <ul class="familia-productos">
          {f.productos.map((nombre) => <li>{nombre}</li>)}
        </ul>
      </li>
    ))}
  </ul>

  {/* 17-nov-2026: pegado al directorio, como su última fila */}
  <BuscasAlgo />
</div>
