---
// Iconos de línea que se repiten por toda la web (16-nov-2026, máster: antes el mismo dibujo estaba copiado en 15 sitios).
// El color del trazo lo pone el botón o el texto de alrededor (currentColor), o la clase que se le pase.
interface Props { nombre: 'correo' | 'telefono'; class?: string }
const { nombre, class: clase = 'size-5 fill-none stroke-2' } = Astro.props;
---
{nombre === 'correo'
  ? <svg aria-hidden="true" viewBox="0 0 24 24" class={clase}><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
  : <svg aria-hidden="true" viewBox="0 0 24 24" class={clase}><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>}
