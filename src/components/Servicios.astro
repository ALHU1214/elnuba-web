---
// Servicios bajo las marcas, en bloques (9-nov-2026, "Escaparate"). Solo servicios confirmados (CLAUDE.md del cliente).
// "Reparto a todas las islas" ya va en la portada, así que aquí no se repite.
const servicios = [
  { titulo: 'Entrega a domicilio', texto: 'En tu colegio u oficina', icono: 'M3 11l9-7 9 7 M5 10v10h14V10 M10 20v-6h4v6' },
  { titulo: 'Recogida en tienda', texto: 'Los Majuelos y Candelaria', icono: 'M4 9l1.5-5h13L20 9 M4 9h16v2a3 3 0 0 1-6 0 3 3 0 0 1-4 0 3 3 0 0 1-6 0z M5 13v7h14v-7' },
  { titulo: 'Al por mayor y al detalle', texto: 'Para centros, empresas y público', icono: 'M3 8l9-5 9 5-9 5z M3 8v8l9 5 9-5V8 M12 13v8' },
];
---
<section aria-label="Servicios" class="mx-auto mt-3 max-w-7xl px-4 md:mt-4 md:px-6">
  <ul class="grid gap-3 sm:grid-cols-3 md:gap-4">
    {servicios.map((s) => (
      <li class="bloque flex items-center gap-4 p-5 md:p-6">
        <span class="icono-tile grid size-12 shrink-0 place-items-center rounded-full">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-current stroke-[1.6] [stroke-linecap:round] [stroke-linejoin:round]"><path d={s.icono} /></svg>
        </span>
        <span class="leading-tight">
          <span class="block font-bold">{s.titulo}</span>
          <span class="mt-1 block text-sm text-gris">{s.texto}</span>
        </span>
      </li>
    ))}
  </ul>
</section>
