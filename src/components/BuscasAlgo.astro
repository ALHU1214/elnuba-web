---
// "¿No ves lo que buscas?": cierra "Qué distribuimos". Deja claro que la lista es solo una muestra y lleva a preguntar
// por correo (plantilla de consulta por un artículo) o a llamar.
// 16-nov-2026 (máster): sacado de Familias.astro a su propio componente.
// 17-nov-2026 (aspecto visual; antes: caja gris con la lupa en un círculo y dos botones). "La fila que falta": va como
// la última fila del directorio, con la misma rejilla (pregunta en la columna de los nombres; texto y botones en la de
// los artículos) y la lupa suelta que se dibuja como los iconos de las familias. "lo que buscas", en naranja.
// CSS: .buscas… en global.css.
import Icono from './Icono.astro';
import { correos, telHref, negocio } from '../data/negocio';

interface Props { class?: string }
const { class: clase = '' } = Astro.props;
---
<div class:list={['buscas', clase]} data-al-ver>
  <p class="buscas-pregunta">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="buscas-icono"><path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14z M20 20l-4-4" pathLength="1" /></svg>
    <span>¿No ves <span class="buscas-marca">lo que buscas</span>?</span>
  </p>
  <div>
    <p class="buscas-texto">Esto es solo una muestra: tenemos todo el material de papelería, escolar y de oficina. Pregúntanos por cualquier artículo.</p>
    <div class="buscas-botones">
      <a href={correos.articulo} class="btn-primario">
        <Icono nombre="correo" />
        Preguntar por correo
      </a>
      <a href={telHref} class="btn-secundario">
        <Icono nombre="telefono" />
        Llamar al {negocio.telefono}
      </a>
    </div>
  </div>
</div>
