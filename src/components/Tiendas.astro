---
// Las dos tiendas abiertas al público.
// 11-nov-2026 (Álvaro): en Contacto (mapas={true}), cada ficha lleva arriba su mapa, pequeño y discreto. Hasta que se
// pulsa "Ver en el mapa" solo hay un mapa dibujado con CSS y no se conecta con Google (ni cookies): así la web sigue
// cumpliendo su política de privacidad, que lo explica. Al pulsar, el mapa de Google se carga en el mismo hueco.
// Sin JavaScript, el botón abre Google Maps en otra pestaña. "Cómo llegar" abre la ruta en Google Maps.
// 13-nov-2026: Contacto ya no usa este componente (tiene su propio diseño: Los Majuelos destacado y Candelaria como
// extra). El mapa está en MapaGoogle.astro.
import { tiendas } from '../data/negocio';
import Pendiente from './Pendiente.astro';
import MapaGoogle from './MapaGoogle.astro';

interface Props { mapas?: boolean }
const { mapas = false } = Astro.props;
const comoLlegar = (t: string) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(t)}`;
---
<div class="grid gap-5 md:grid-cols-2">
  {tiendas.map((t) => (
    <article id={t.id} class="scroll-mt-28 overflow-hidden rounded-2xl bg-white ring-1 ring-linea">
      {mapas && <MapaGoogle consulta={t.mapa} titulo={`Mapa: ${t.nombre}`} />}
      <div class="p-7">
        <p class="antetitulo text-xs font-bold tracking-[.24em] text-naranja-oscuro uppercase">{t.lugar}</p>
        <h3 class="mt-2 text-2xl font-semibold">{t.nombre}</h3>
        <p class="mt-1 text-gris">{t.nota}</p>
        <p class="mt-4 leading-relaxed">{t.direccion.map((l) => <>{l}<br /></>)}</p>
        {mapas && (
          <p class="mt-2">
            <a href={comoLlegar(t.mapa)} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-sm font-bold text-naranja-oscuro hover:underline">
              Cómo llegar
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2"><path d="M7 17 17 7 M9 7h8v8" /></svg>
              <span class="sr-only">(abre Google Maps en otra pestaña)</span>
            </a>
          </p>
        )}
        <p class="mt-4"><a href={`tel:${t.telefonoE164}`} class="font-bold text-naranja-oscuro hover:underline">{t.telefono}</a></p>
        <p class="mt-3 text-gris">{t.horario ? t.horario.join(' · ') : <>Horario: <Pendiente /></>}</p>
        {t.extras.length > 0 && (
          <ul class="mt-5 space-y-2 border-t border-linea pt-5 text-gris">
            {t.extras.map((e) => <li class="flex gap-2.5"><span aria-hidden="true" class="mt-2 size-2 shrink-0 rounded-full bg-naranja"></span>{e}</li>)}
          </ul>
        )}
      </div>
    </article>
  ))}
</div>
