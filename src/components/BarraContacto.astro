---
import Icono from './Icono.astro';
// Barra fija abajo en el móvil: llamar o escribir en un toque
import { telHref, correos, type TipoCorreo } from '../data/negocio';
interface Props { correo?: TipoCorreo }
const { correo = 'general' } = Astro.props;
---
{/* 16-nov-2026 (máster): es un <nav> con nombre para que los lectores de pantalla la encuentren (antes, un <div> suelto) */}
<nav aria-label="Contacto rápido" class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-pizarra-2 bg-pizarra text-white md:hidden">
  <a href={telHref} class="flex h-16 items-center justify-center gap-2 font-bold">
    <Icono nombre="telefono" class="size-5 fill-none stroke-amarillo stroke-2" />
    Llamar
  </a>
  <a href={correos[correo]} class="flex h-16 items-center justify-center gap-2 border-l border-pizarra-2 font-bold">
    <Icono nombre="correo" class="size-5 fill-none stroke-amarillo stroke-2" />
    Escribir
  </a>
</nav>
