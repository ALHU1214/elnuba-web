---
// Preguntas frecuentes visibles + su marcado FAQPage para Google.
// 9-nov-2026: los dos bloques miden lo mismo; el melocotón ofrece llamar y escribir; las preguntas van numeradas,
// si son pocas (hasta 4) salen todas abiertas, para leerlas sin pulsar; si son más, solo la primera.
import { negocio, telHref, correos, type TipoCorreo } from '../data/negocio';

interface Props { preguntas: { p: string; r: string }[]; titulo?: string; correo?: TipoCorreo; }
const { preguntas, titulo = 'Preguntas frecuentes', correo = 'general' } = Astro.props;

const faqJsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
};
---
<section class="mx-auto max-w-7xl px-4 py-14 md:px-6 md:py-20">
  <div class="grid gap-3 md:gap-4 lg:grid-cols-[1fr_1.6fr]">
    <div class="flex flex-col justify-between gap-8 rounded-[2rem] bg-melocoton p-7 sm:p-10">
      <div>
        <p class="antetitulo sobre-color text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Dudas</p>
        <h2 class="mt-3 text-4xl md:text-5xl">{titulo}</h2>
        <p class="mt-5 max-w-sm leading-relaxed text-gris">¿No está tu pregunta? Pregúntanos por teléfono o por correo.</p>
      </div>
      <ul class="grid gap-2">
        <li>
          <a href={telHref} class="group flex items-center gap-4 rounded-2xl bg-white p-3 pr-5 transition hover:-translate-y-0.5">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-naranja">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-[#13203a] stroke-2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
            </span>
            <span class="leading-tight">
              <span class="block text-[11px] font-bold tracking-[.14em] text-gris uppercase">Llámanos</span>
              <span class="block text-lg font-bold">{negocio.telefono}</span>
            </span>
            <span aria-hidden="true" class="ml-auto text-naranja-oscuro transition group-hover:translate-x-1">→</span>
          </a>
        </li>
        <li>
          <a href={correos[correo]} class="group flex items-center gap-4 rounded-2xl bg-white p-3 pr-5 transition hover:-translate-y-0.5">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-tinta">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-naranja stroke-2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            </span>
            <span class="leading-tight">
              <span class="block text-[11px] font-bold tracking-[.14em] text-gris uppercase">Escríbenos</span>
              <span class="block text-lg font-bold">Pedir presupuesto</span>
            </span>
            <span aria-hidden="true" class="ml-auto text-naranja-oscuro transition group-hover:translate-x-1">→</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="bloque p-2 sm:p-3">
      {preguntas.map((q, i) => (
        <details class="group border-b border-linea px-4 last:border-b-0 sm:px-6" open={preguntas.length <= 4 || i === 0}>
          <summary class="flex cursor-pointer list-none items-center gap-4 py-5 text-lg font-semibold [&::-webkit-details-marker]:hidden md:py-6">
            <span class="w-7 shrink-0 text-sm font-bold text-naranja-oscuro tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span class="flex-1">{q.p}</span>
            <span aria-hidden="true" class="grid size-9 shrink-0 place-items-center rounded-full bg-papel text-xl text-naranja-oscuro transition group-open:rotate-45 group-open:bg-naranja group-open:text-[#13203a]">+</span>
          </summary>
          <p class="-mt-1 pr-4 pb-6 pl-11 leading-relaxed text-gris sm:pr-12">{q.r}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonld)} />
</section>
