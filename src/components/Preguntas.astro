---
import Icono from './Icono.astro';
// Preguntas frecuentes: "tarjetas que giran" (11-nov-2026, elegida por Álvaro entre dos opciones probadas en una página
// de prueba; antes: hoja con rayas, tarjetas blancas y versión editorial, descartadas).
// Cada pregunta es una tarjeta con el color de su tema (Pedidos naranja, Reparto marino, Material rojo, Tiendas
// melocotón: los del logo, sin amarillo de fondo); al pulsarla gira en 3D y por detrás está la respuesta. Se pueden
// girar varias. Sin temas (Colegios, Empresas), los colores van uno detrás de otro y la etiqueta la pone la página.
// Debajo, "¿No está tu pregunta?" con los botones de siempre. Las tarjetas entran con una animación al verse la sección
// y al cambiar de tema. Sin JavaScript, cada tarjeta enseña la pregunta y la respuesta seguidas y se ven todos los
// temas; con "reducir movimiento", cambia sin girar. Marcado FAQPage para Google con todas las preguntas.
// OJO: la lista de tarjetas no puede llevar la clase "grid": Efectos.astro anima al verlos los hijos de las rejillas y
// los de los temas ocultos se quedarían invisibles.
import { negocio, telHref, correos, type TipoCorreo } from '../data/negocio';
import { temas, type Pregunta } from '../data/preguntas';

interface Props { preguntas: Pregunta[]; titulo?: string; correo?: TipoCorreo; etiqueta?: string; }
const { preguntas, titulo = 'Preguntas frecuentes', correo = 'general', etiqueta = 'Dudas' } = Astro.props;

const conTemas = preguntas.some((q) => q.tema);
const hojas = conTemas
  ? Object.entries(temas)
      .map(([id, t]) => ({ id, ...t, preguntas: preguntas.filter((q) => q.tema === id) }))
      .filter((h) => h.preguntas.length > 0)
  : [{ id: 'todas', nombre: '', tinta: '', icono: '', preguntas }];
// Cada tarjeta lleva el color de una de las 4 posiciones de la paleta: por tema o, sin temas, una detrás de otra
const posicionTema: Record<string, number> = { pedidos: 1, reparto: 2, material: 3, tiendas: 4 };
const faqJsonld = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r } })),
};
---
{/* 16-nov-2026 (máster): sin margen arriba; la sección de antes ya trae el suyo (sumados daban 160 px, el doble que entre los demás bloques) */}
<section class="mx-auto max-w-7xl px-4 pb-10 md:px-6 md:pb-20" data-gr>
  <div class="gr-marco">
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="antetitulo text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Dudas</p>
      <h2 class="mt-3 text-4xl md:text-5xl">{titulo}</h2>
      <p class="mt-4 text-lg text-gris">Pulsa una pregunta para ver la respuesta.</p>
    </div>
    {conTemas && (
      <div role="tablist" aria-label="Temas de las preguntas" class="gr-temas">
        {hojas.map((h, i) => (
          <button type="button" role="tab" id={`gr-pestana-${h.id}`} aria-controls={`gr-hoja-${h.id}`}
                  aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="gr-tema" style={`--icono:${h.tinta}`}>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d={h.icono} /></svg>
            {h.nombre}
          </button>
        ))}
      </div>
    )}
  </div>

  <div class="mt-8 md:mt-10">
    {hojas.map((h, i) => (
      <div class:list={['gr-hoja', i === 0 && 'activa']} role={conTemas ? 'tabpanel' : undefined}
           id={conTemas ? `gr-hoja-${h.id}` : undefined} aria-labelledby={conTemas ? `gr-pestana-${h.id}` : undefined}>
        {conTemas && <p class="gr-tema-nombre">{h.nombre}</p>}
        <ul class="gr-rejilla" style={`--cols:${h.preguntas.length <= 4 ? h.preguntas.length : 3}`}>
          {h.preguntas.map((q, j) => (
            <li class="gr-sitio" style={`--n:${j}`}>
              <button type="button" class="gr-carta" aria-expanded="false" data-color={conTemas ? posicionTema[h.id] : (j % 4) + 1}>
                <span class="gr-cara gr-frente">
                  <span class="gr-etiqueta">{h.nombre || etiqueta}</span>
                  <span class="gr-pregunta">{q.p}</span>
                  <span class="gr-pista">Ver respuesta
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5" /></svg>
                  </span>
                </span>
                <span class="gr-cara gr-dorso">
                  <span class="gr-respuesta">{q.r}</span>
                  <span class="gr-pista">Volver
                    <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2.3-5.7M4 4v5h5" /></svg>
                  </span>
                </span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {/* 17-nov-2026 (aspecto visual; antes, una barra blanca con un texto pequeño): cierre en letra grande con una raya
      marino encima, sin caja; "tu pregunta", en naranja */}
  <div class="gr-ayuda">
    <p class="gr-ayuda-pregunta">¿No está <span class="gr-ayuda-marca">tu pregunta</span>?</p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={correos[correo]} class="btn-primario">
        <Icono nombre="correo" />
        Escríbenos
      </a>
      <a href={telHref} class="btn-secundario">Llamar al {negocio.telefono}</a>
    </div>
  </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonld)} />
</section>

<style>
  /* Temas: botones redondeados sobre una pista piedra; el elegido, blanco con su icono de color */
  .gr-temas { display: flex; gap: .25rem; padding: .3rem; border-radius: 999px; background: #e7e1d6; overflow-x: auto; scrollbar-width: none; }
  .gr-tema {
    display: inline-flex; flex: 1 0 auto; align-items: center; justify-content: center; gap: .5rem; min-height: 2.75rem; padding: .65rem 1rem; border-radius: 999px; /* min-height: 44 px para el dedo (24-nov-2026; antes 40) */
    color: var(--color-gris); font-size: .875rem; font-weight: 700; white-space: nowrap; transition: background-color .2s, color .2s, box-shadow .2s;
  }
  .gr-tema svg { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .gr-tema:hover { color: var(--color-tinta); }
  .gr-tema[aria-selected="true"] { background: #fff; color: var(--color-tinta); box-shadow: 0 1px 2px rgb(19 32 58 / .08), 0 6px 14px -8px rgb(19 32 58 / .3); }
  .gr-tema[aria-selected="true"] svg { color: var(--icono); }
  @media (max-width: 639px) { .gr-tema svg { display: none; } .gr-tema { padding: .6rem .7rem; } }
  /* 16-nov-2026 (máster): a 320 px el cuarto tema ("Tienda") quedaba cortado; más juntos y con la letra un punto menor, caben los cuatro */
  @media (max-width: 359px) { .gr-temas { gap: .15rem; } .gr-tema { padding: .55rem .4rem; font-size: .8125rem; } }
  @media (min-width: 1024px) { .gr-temas { align-self: flex-end; } }
  [data-gr]:not([data-gr-listo]) .gr-temas { display: none; }
  .gr-tema-nombre { margin: 1.5rem 0 .75rem; font-size: .75rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--color-naranja-oscuro); }
  [data-gr-listo] .gr-tema-nombre { display: none; }
  [data-gr-listo] .gr-hoja:not(.activa) { display: none; }

  /* Rejilla: 1 columna en el móvil, 2 en tableta y, en el ordenador, tantas como tarjetas (hasta 4; con 6, 3) */
  .gr-rejilla { display: grid; gap: 1rem; }
  @media (min-width: 640px) { .gr-rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .gr-rejilla { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: 1.25rem; } }
  /* Entrada: al verse la sección por primera vez y al cambiar de tema, una detrás de otra.
     17-nov-2026: el estado "escondida antes de verse" solo con movimiento. Antes también se aplicaba con "reducir
     movimiento": como ahí no hay animación, las tarjetas seguían invisibles hasta que la sección asomaba (y en una
     captura de página entera, o al imprimir, la zona salía vacía) */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-gr-listo]:not([data-gr-visto]) .gr-sitio { opacity: 0; }
  }
  [data-gr-visto] .gr-hoja.activa .gr-sitio { animation: gr-entra .6s cubic-bezier(.22, 1, .36, 1) both; animation-delay: calc(var(--n) * 70ms); }
  @keyframes gr-entra { from { opacity: 0; transform: translateY(18px) rotate(-1.5deg); } }

  /* Colores de las tarjetas, por posición (1 Pedidos, 2 Reparto, 3 Material, 4 Tiendas). Por defecto, la de antes (naranja, marino, rojo y melocotón). Contraste comprobado (WCAG): texto ≥ 5,2:1 y etiqueta pequeña ≥ 4,5:1.
     --borde: el filo de la cara de atrás (en los colores claros, un tono más oscuro para que se vea) */
  .gr-carta[data-color="1"] { --fondo: #f78a37; --texto: #13203a; --suave: #13203a; }
  .gr-carta[data-color="2"] { --fondo: #13203a; --texto: #f6f7f9; --suave: #b9c0cf; }
  .gr-carta[data-color="3"] { --fondo: #d63b3b; --texto: #fff; --suave: #fff; }
  .gr-carta[data-color="4"] { --fondo: #ffe9d9; --texto: #13203a; --suave: #8a4a1f; --borde: #f3c6a4; }
  /* 13-nov-2026: Álvaro se queda con estos colores ("tarjetas antes"). Las paletas de prueba (dos tintas, tonal y joya)
     se quitaron con la barra de prueba */

  .gr-carta { display: flex; flex-direction: column; gap: 1rem; width: 100%; height: 100%; text-align: left; cursor: pointer; }
  .gr-cara { display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; min-height: 11.5rem; padding: 1.5rem; border-radius: 1.5rem; }
  @media (min-width: 1024px) { .gr-cara { min-height: 14rem; padding: 1.6rem; } }

  .gr-frente { background: var(--fondo); color: var(--texto); }
  .gr-dorso { background: #fff; color: var(--color-tinta); box-shadow: inset 0 0 0 2px var(--borde, var(--fondo)), 0 18px 34px -24px rgb(19 32 58 / .45); }
  .gr-etiqueta { font-size: .75rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--suave); }
  .gr-pregunta { font-size: 1.3rem; line-height: 1.2; font-weight: 800; letter-spacing: -.02em; }
  @media (min-width: 1024px) { .gr-pregunta { font-size: 1.35rem; } }
  .gr-respuesta { font-size: 1.0625rem; line-height: 1.6; overflow-wrap: anywhere; } /* el correo es una "palabra" muy larga */
  .gr-pista { display: inline-flex; align-items: center; gap: .5rem; font-size: .875rem; font-weight: 700; }
  .gr-frente .gr-pista { color: var(--texto); }
  .gr-dorso .gr-pista { color: var(--color-naranja-oscuro); }
  .gr-pista svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform .5s cubic-bezier(.22, 1, .36, 1); }

  /* Con JavaScript: las dos caras en el mismo sitio y el giro en 3D (con un pequeño rebote al final) */
  [data-gr-listo] .gr-carta { display: grid; grid-template-columns: minmax(0, 1fr); perspective: 1300px; transition: transform .3s cubic-bezier(.22, 1, .36, 1); }
  [data-gr-listo] .gr-cara { grid-area: 1 / 1; backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: transform .85s cubic-bezier(.3, 1.35, .5, 1), box-shadow .3s; }
  [data-gr-listo] .gr-frente { box-shadow: 0 18px 34px -24px rgb(19 32 58 / .5); }
  [data-gr-listo] .gr-dorso { transform: rotateY(180deg); }
  [data-gr-listo] .gr-carta[aria-expanded="true"] .gr-frente { transform: rotateY(-180deg); }
  [data-gr-listo] .gr-carta[aria-expanded="true"] .gr-dorso { transform: rotateY(0); }
  @media (hover: hover) {
    [data-gr-listo] .gr-carta:hover { transform: translateY(-5px); }
    [data-gr-listo] .gr-carta:hover .gr-frente .gr-pista svg { transform: rotate(-90deg); }
  }
  .gr-carta:focus-visible { outline: none; }
  .gr-carta:focus-visible .gr-cara { outline: 3px solid var(--color-tinta); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    [data-gr-listo] .gr-cara { transform: none !important; }
    [data-gr-listo] .gr-carta[aria-expanded="true"] .gr-frente, [data-gr-listo] .gr-carta[aria-expanded="false"] .gr-dorso { visibility: hidden; }
  }

  .gr-ayuda { display: flex; flex-direction: column; gap: 1.25rem; margin-top: 2.5rem; padding-top: 1.75rem; border-top: 2px solid var(--color-tinta); }
  @media (min-width: 768px) { .gr-ayuda { flex-direction: row; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 3rem; padding-top: 2rem; } }
  .gr-ayuda-pregunta { font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.6rem); font-weight: 800; line-height: 1.05; letter-spacing: -.035em; }
  .gr-ayuda-marca { color: var(--color-naranja-oscuro); }

  /* 24-nov-2026 (Álvaro: "los bloques son muy grandes para móvil, compáctalo"). En el móvil las preguntas son un
     acordeón: cada una, una fila de su color con un "+"; al tocarla, la respuesta se abre debajo (en blanco, con el filo
     del mismo color) y el "+" pasa a "×". Seis tarjetas que giran medían 1.200 px (casi dos pantallas); así, unos 450.
     En la tableta y el ordenador siguen las tarjetas que giran. Sin JavaScript se ven pregunta y respuesta seguidas */
  @media (max-width: 639px) {
    .gr-rejilla { gap: .5rem; }
    .gr-cara { min-height: 0; }
    .gr-frente .gr-etiqueta, .gr-cara .gr-pista { display: none; }
    .gr-pregunta { font-size: 1.0625rem; line-height: 1.3; }
    .gr-respuesta { font-size: 1rem; }
    .gr-frente { flex-direction: row; align-items: center; gap: 1rem; padding: .95rem 1rem .95rem 1.15rem; border-radius: 1.1rem; }
    .gr-frente::after {
      content: ""; flex-shrink: 0; width: 1.9rem; height: 1.9rem; margin-left: auto; border-radius: 999px;
      background: linear-gradient(currentColor, currentColor) center / .8rem 2px no-repeat, linear-gradient(currentColor, currentColor) center / 2px .8rem no-repeat;
      box-shadow: inset 0 0 0 1.5px color-mix(in oklab, currentColor 45%, transparent); transition: transform .3s cubic-bezier(.22, 1, .36, 1);
    }
    .gr-carta[aria-expanded="true"] .gr-frente::after { transform: rotate(45deg); }
    .gr-dorso { padding: 1rem 1.15rem; border-radius: 1.1rem; }
    [data-gr-listo] .gr-carta[aria-expanded] { display: flex; flex-direction: column; gap: .35rem; perspective: none; }
    [data-gr-listo] .gr-carta[aria-expanded] .gr-cara { transform: none; backface-visibility: visible; -webkit-backface-visibility: visible; transition: none; }
    [data-gr-listo] .gr-carta[aria-expanded="false"] .gr-dorso { display: none; }
  }
</style>

<script>
  // Girar tarjetas, cambiar de tema (flechas, Inicio y Fin) y la entrada de las tarjetas al verse la sección
  document.querySelectorAll<HTMLElement>('[data-gr]').forEach((s) => {
    s.querySelectorAll<HTMLButtonElement>('.gr-carta').forEach((carta) => {
      const frente = carta.querySelector('.gr-frente')!, dorso = carta.querySelector('.gr-dorso')!;
      dorso.setAttribute('aria-hidden', 'true');
      carta.addEventListener('click', () => {
        const girada = carta.getAttribute('aria-expanded') !== 'true';
        carta.setAttribute('aria-expanded', String(girada));
        frente.setAttribute('aria-hidden', String(girada));
        dorso.setAttribute('aria-hidden', String(!girada));
      });
    });
    const pestanas = [...s.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const hojas = [...s.querySelectorAll<HTMLElement>('.gr-hoja')];
    const elegir = (i: number, foco: boolean) => {
      pestanas.forEach((p, j) => { p.setAttribute('aria-selected', String(i === j)); p.tabIndex = i === j ? 0 : -1; hojas[j].classList.toggle('activa', i === j); });
      if (foco) pestanas[i].focus();
    };
    pestanas.forEach((p, i) => {
      p.addEventListener('click', () => elegir(i, false));
      p.addEventListener('keydown', (e) => {
        const n = pestanas.length;
        const ir = { ArrowRight: (i + 1) % n, ArrowLeft: (i - 1 + n) % n, Home: 0, End: n - 1 }[e.key];
        if (ir !== undefined) { e.preventDefault(); elegir(ir, true); }
      });
    });
    const vigia = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      s.setAttribute('data-gr-visto', '');
      vigia.disconnect();
    }, { rootMargin: '0px 0px -12% 0px' });
    vigia.observe(s.querySelector('.gr-rejilla')!);
    s.setAttribute('data-gr-listo', '');
  });
</script>
