---
import { ruta } from '../lib/ruta';
import { negocio, nav, telHref, mailHref } from '../data/negocio';
import Pendiente from './Pendiente.astro';
const d = negocio.direccion;
---
<footer class="bg-pizarra text-white/80">
  <div class="franjas h-1"></div>
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 md:grid-cols-[1.4fr_1fr_1fr] md:px-6">
    <div>
      <img src={ruta('/logo-elnuba-240.webp')} srcset={`${ruta('/logo-elnuba-240.webp')} 240w, ${ruta('/logo-elnuba-480.webp')} 480w`} sizes="150px" alt="ELNUBA Distribuciones de Papelería" width="240" height="90" loading="lazy" decoding="async" class="h-14 w-auto" />
      <p class="mt-5 max-w-sm leading-relaxed">Distribución de papelería, material de oficina y librería para colegios, empresas y organismos públicos de Canarias.</p>
    </div>
    <div>
      <h2 class="font-sans text-xs font-bold tracking-[.24em] text-amarillo uppercase">Contacto</h2>
      <ul class="mt-4 space-y-2.5">
        <li><a href={telHref} class="font-semibold text-white hover:underline">{negocio.telefono}</a></li>
        <li><a href={mailHref} class="break-all hover:underline">{negocio.email}</a></li>
        <li>{d.calle}<br />{d.zona}<br />{d.cp} {d.localidad}</li>
        <li>{negocio.horario ? negocio.horario.map((h) => <span class="block">{h}</span>) : <>Horario: <Pendiente /></>}</li>
        <li><a href={ruta('/contacto/#candelaria')} class="hover:underline">También en Candelaria: Librería Mararía</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-xs font-bold tracking-[.24em] text-amarillo uppercase">La web</h2>
      <ul class="mt-4 space-y-2.5">
        {nav.map((n) => <li><a href={ruta(n.href)} class="hover:underline">{n.label}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-3 px-4 py-6 text-sm text-white/60 md:px-6">
      <p>© {new Date().getFullYear()} {negocio.razonSocial} · CIF {negocio.cif}</p>
      <p class="flex gap-5"><a href={ruta('/aviso-legal/')} class="hover:underline">Aviso legal</a><a href={ruta('/privacidad/')} class="hover:underline">Privacidad</a></p>
    </div>
  </div>
</footer>
