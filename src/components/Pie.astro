---
import { ruta } from '../lib/ruta';
import { negocio, nav, telHref, mailHref, filasHorario, hayAnalitica } from '../data/negocio';
import Pendiente from './Pendiente.astro';
// Pie (17-nov-2026, aspecto visual; antes: tres columnas iguales de letra pequeña, correcto pero plano).
// Jerarquía de revista: a la izquierda, el logo y la frase de ELNUBA en grande; a la derecha, tres columnas
// (contacto con el teléfono en grande, horario y la web). La franja del lápiz de arriba se dibuja al llegar al pie.
// Los textos son los de siempre. CSS: .pie… en global.css.
const d = negocio.direccion;
---
<footer class="bg-pizarra text-white/80">
  <div class="franjas trazo h-1.5" data-revelar></div>
  <div class="mx-auto max-w-7xl px-4 pt-14 pb-12 md:px-6 md:pt-20 md:pb-16">
    <div class="pie-reparto">
      <div>
        <img src={ruta('/logo-elnuba-240.webp')} srcset={`${ruta('/logo-elnuba-240.webp')} 240w, ${ruta('/logo-elnuba-480.webp')} 480w`} sizes="150px" alt="ELNUBA Distribuciones de Papelería" width="240" height="90" loading="lazy" decoding="async" class="h-14 w-auto" />
        <p class="pie-lema">Distribución de papelería, material de oficina y librería para colegios, empresas y organismos públicos de Canarias.</p>
      </div>
      <div class="pie-columnas">
        <div>
          <h2 class="pie-rotulo">Contacto</h2>
          {/* 16-nov-2026 (máster): los enlaces del pie llevan algo de alto para acertar con el dedo en el móvil */}
          <a href={telHref} class="pie-telefono hover:underline">{negocio.telefono}</a>
          <a href={mailHref} class="pie-correo hover:underline">{negocio.email}</a>
          <p class="pie-direccion">{d.calle}<br />{d.zona}<br />{d.cp} {d.localidad}</p>
        </div>
        <div>
          {/* 16-nov-2026 (Álvaro): horario resaltado, con su título */}
          <h2 class="pie-rotulo">Horario</h2>
          {negocio.horario
            ? <dl class="pie-horario">{filasHorario.map((f) => <><dt>{f.dias}</dt><dd>{f.horas}</dd></>)}</dl>
            : <p class="mt-3"><Pendiente /></p>}
        </div>
        <div>
          <h2 class="pie-rotulo">La web</h2>
          <ul class="mt-3 space-y-1">
            {nav.map((n) => <li><a href={ruta(n.href)} class="inline-block py-1 hover:underline">{n.label}</a></li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
  {/* 17-nov-2026 (Álvaro): fuera el CIF de esta línea. No es obligatorio aquí: la LSSI pide que los datos de la empresa
      (CIF incluido) estén a mano desde cualquier página, y eso lo cumple el enlace "Aviso legal", que NO se puede quitar */}
  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-7xl flex-wrap justify-between gap-3 px-4 py-6 text-sm text-white/60 md:px-6">
      <p>© {new Date().getFullYear()} {negocio.razonSocial}</p>
      <p class="flex flex-wrap gap-x-5 gap-y-1"><a href={ruta('/aviso-legal/')} class="-my-1 inline-block py-1 hover:underline">Aviso legal</a><a href={ruta('/privacidad/')} class="-my-1 inline-block py-1 hover:underline">Privacidad</a>{hayAnalitica && <button type="button" data-cookies-abrir class="-my-1 inline-block py-1 hover:underline">Configurar cookies</button>}</p>
    </div>
  </div>
</footer>
