---
import Icono from './Icono.astro';
import { ruta } from '../lib/ruta';
// Cabecera (9-nov-2026): barra blanca flotante y redondeada, como los bloques del estilo "Escaparate".
// Menú con la página actual marcada, teléfono con su etiqueta y el botón principal "Pedir presupuesto".
// En el móvil: logo y botón de menú (llamar y escribir ya están en la barra fija de abajo).
import { nav, negocio, telHref, correos, type TipoCorreo } from '../data/negocio';
interface Props { correo?: TipoCorreo }
const { correo = 'general' } = Astro.props;
const actual = Astro.url.pathname;
---
<header class="sticky top-0 z-40 pt-2.5 md:pt-3">
  {/* Mismo ancho y márgenes que el contenido, para que la barra alinee con los bloques de debajo */}
  <div class="mx-auto max-w-7xl px-4 md:px-6">
  {/* Blanca opaca (11-nov-2026): con el fondo punteado, al 95 % se transparentaban los puntos y el texto de debajo */}
  <div class="barra flex h-16 items-center justify-between gap-4 rounded-full bg-white pr-2 pl-5 md:h-[4.5rem] md:pl-6">
    <a href={ruta('/')} class="shrink-0" aria-label="ELNUBA, inicio">
      {/* 13-nov-2026: logo a su tamaño (96 px de ancho en el móvil, 118 en el ordenador); antes bajaba uno de 1280 px y 117 KB */}
      <img src={ruta('/logo-elnuba-240.webp')} srcset={`${ruta('/logo-elnuba-240.webp')} 240w, ${ruta('/logo-elnuba-480.webp')} 480w`} sizes="(min-width: 768px) 118px, 96px" alt="ELNUBA Distribuciones de Papelería" width="240" height="90" fetchpriority="high" class="h-9 w-auto md:h-11" />
    </a>

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 text-[14px] font-semibold xl:gap-1 xl:text-[15px]">
        {nav.map((n) => (
          <li>
            <a href={ruta(n.href)} aria-current={actual.startsWith(ruta(n.href)) ? 'page' : undefined}
               class="block rounded-full px-2.5 py-2.5 whitespace-nowrap xl:px-4 text-tinta/75 transition-colors hover:bg-papel hover:text-tinta aria-[current=page]:bg-melocoton aria-[current=page]:text-tinta">{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    {/* 11-nov-2026 (Álvaro: "más llamativos"): llamar en pastilla marino y "Pedir presupuesto" con sobre y brillo.
        "Pedir presupuesto" sale ya desde 768 px (antes, solo con el menú a la vista). Entre 1024 y 1179 px queda solo el
        círculo del teléfono (el número se sigue leyendo con lector de pantalla). Estilos: .btn-llamar y .btn-cabecera
        24-nov-2026: con «Fotocopias» en el menú (5 enlaces), eso pasa hasta 1279 px y los enlaces van algo más juntos y
        a 14 px hasta 1280; si no, entre 1024 y 1279 px los botones se salían de la barra */}
    <div class="flex items-center gap-2">
      <a href={telHref} class="btn-llamar hidden sm:inline-flex">
        <span class="btn-llamar-icono">
          <Icono nombre="telefono" class="size-[18px] fill-none stroke-[#13203a] stroke-2 md:size-5" />
        </span>
        <span class="leading-tight lg:max-[1279px]:sr-only">
          <span class="block text-[11px] font-bold tracking-[.14em] text-[#ff9a4d] uppercase">Llámanos </span>
          <span class="block text-[15px] font-bold whitespace-nowrap">{negocio.telefono}</span>
        </span>
      </a>
      <a href={correos[correo]} class="btn-primario btn-cabecera hidden md:inline-flex">
        <Icono nombre="correo" class="size-5 fill-none stroke-2 lg:max-[1279px]:hidden" />
        Pedir presupuesto
      </a>
      <button id="menu-boton" type="button" aria-expanded="false" aria-controls="menu-movil"
              class="inline-flex size-12 items-center justify-center rounded-full bg-papel transition-colors hover:bg-melocoton md:size-14 lg:hidden">
        {/* 16-nov-2026 (máster): abierto, el botón enseña una X y dice "Cerrar menú" (antes seguían las tres rayas) */}
        <span class="sr-only" data-menu-texto>Abrir menú</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-tinta stroke-2 [stroke-linecap:round]"><path class="menu-rayas" d="M4 7h16M4 12h16M4 17h16" /><path class="menu-equis" d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>

  {/* Menú del móvil y la tableta: panel blanco bajo la barra, con los dos botones de contacto */}
  <nav id="menu-movil" aria-label="Menú" hidden class="barra mt-2 rounded-[1.75rem] bg-white p-2.5 lg:hidden">
    <ul>
      {nav.map((n) => (
        <li><a href={ruta(n.href)} aria-current={actual.startsWith(ruta(n.href)) ? 'page' : undefined}
               class="block rounded-2xl px-4 py-3.5 text-lg font-semibold transition-colors hover:bg-papel aria-[current=page]:bg-melocoton">{n.label}</a></li>
      ))}
    </ul>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <a href={correos[correo]} class="btn-primario">Pedir presupuesto por correo</a>
      <a href={telHref} class="btn-secundario">Llamar al {negocio.telefono}</a>
    </div>
  </nav>
  </div>
</header>

{/* Sin JavaScript el botón no puede abrir el menú: se enseña abierto y el botón se quita (16-nov-2026, máster) */}
<noscript><style>#menu-movil[hidden] { display: block; } #menu-boton { display: none; } @media (min-width: 1024px) { #menu-movil[hidden] { display: none; } }</style></noscript>

<script>
  const boton = document.getElementById('menu-boton')!;
  const menu = document.getElementById('menu-movil')!;
  const texto = boton.querySelector('[data-menu-texto]')!;
  const poner = (abrir: boolean) => { boton.setAttribute('aria-expanded', String(abrir)); menu.hidden = !abrir; texto.textContent = abrir ? 'Cerrar menú' : 'Abrir menú'; };
  boton.addEventListener('click', () => poner(boton.getAttribute('aria-expanded') !== 'true'));
  // Se cierra con Escape y al pulsar fuera
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { poner(false); boton.focus(); } });
  addEventListener('click', (e) => { if (!menu.hidden && !(e.target as Element).closest('header')) poner(false); });
</script>
