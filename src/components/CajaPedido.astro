---
// "Todo en un pedido" (Empresas, "Por qué ELNUBA"; 17-nov-2026, aspecto visual). Una caja de reparto de cartón, abierta,
// con lo que dice la frase de al lado asomando por arriba: un archivador rojo (archivo), un paquete de folios (papel),
// dos lápices (escritura) y un cartucho (tóner y cartuchos). En el frente, una etiqueta con las tres franjas del lápiz
// del logo: es una caja de ELNUBA. Rellena el hueco que quedaba en medio del bloque blanco.
// Al verse el bloque (.visto, data-al-ver en la página), las cosas caen dentro de la caja una detrás de otra.
// Sin JavaScript o con "reducir movimiento", la caja ya está llena. Dibujo plano con los colores de la web, decorativo.
interface Props { class?: string }
const { class: clase = '' } = Astro.props;
---
<svg viewBox="0 0 300 184" aria-hidden="true" focusable="false" class:list={['caja-pedido', clase]}>
  <ellipse cx="150" cy="176" rx="118" ry="6" fill="#13203a" fill-opacity=".09" />
  {/* Solapa de atrás y solapas de los lados, abiertas */}
  <polygon points="70,96 230,96 225,64 75,64" fill="#e0ad66" />
  <polygon points="60,96 90,96 68,70 36,72" fill="#e9bb78" />
  <polygon points="240,96 210,96 232,70 264,72" fill="#e9bb78" />

  {/* Lo que va dentro (cae al verse): archivador, folios, lápices y cartucho */}
  <g class="caja-cosa" style="--n:0">
    <g transform="rotate(-6 96 120)">
      <rect x="79" y="30" width="34" height="132" rx="3" fill="#e84343" />
      <rect x="85" y="40" width="22" height="26" rx="2" fill="#fff" />
      <circle cx="96" cy="80" r="5.5" fill="#13203a" fill-opacity=".85" />
    </g>
  </g>
  <g class="caja-cosa" style="--n:1">
    <g transform="rotate(3 146 120)">
      <rect x="114" y="54" width="64" height="108" rx="2" fill="#fff" stroke="#d9d2c4" stroke-width="1.5" />
      <path d="M118 60h56 M118 64.5h56" stroke="#e4dfd5" stroke-width="1.2" />
      <rect x="114" y="72" width="64" height="16" fill="#f78a37" />
    </g>
  </g>
  <g class="caja-cosa" style="--n:2">
    <g transform="rotate(8 188 110)">
      <polygon points="180,38 192,38 186,18" fill="#f4c882" />
      <polygon points="183.9,24.3 188.1,24.3 186,18" fill="#13203a" />
      <rect x="180" y="38" width="12" height="124" fill="#13203a" />
    </g>
    <g transform="rotate(15 202 112)">
      <polygon points="195,44 207,44 201,24" fill="#f4c882" />
      <polygon points="198.9,30.3 203.1,30.3 201,24" fill="#f78a37" />
      <rect x="195" y="44" width="12" height="118" fill="#f78a37" />
    </g>
  </g>
  <g class="caja-cosa" style="--n:3">
    <g transform="rotate(-4 222 120)">
      <rect x="213" y="44" width="16" height="8" rx="2" fill="#13203a" />
      <rect x="208" y="50" width="26" height="112" rx="5" fill="#24314d" />
      <rect x="212" y="60" width="18" height="10" rx="2" fill="#f78a37" />
    </g>
  </g>

  {/* Frente de la caja, con el canto de arriba y la etiqueta de ELNUBA (las tres franjas del lápiz del logo) */}
  <rect x="60" y="96" width="180" height="78" rx="3" fill="#f4c882" />
  <rect x="60" y="96" width="180" height="7" fill="#e0ad66" />
  <rect x="60" y="164" width="180" height="10" rx="3" fill="#e0ad66" fill-opacity=".7" />
  <rect x="127" y="118" width="46" height="32" rx="3" fill="#fff" />
  <rect x="134" y="125" width="32" height="4" rx="1" fill="#fce265" />
  <rect x="134" y="132" width="32" height="4" rx="1" fill="#f78a37" />
  <rect x="134" y="139" width="32" height="4" rx="1" fill="#e84343" />
</svg>
