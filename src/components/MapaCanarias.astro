---
// Mapa del reparto (11-nov-2026, Álvaro: "mejorar el aspecto visual" del recuadro "Reparto a todas las islas Canarias").
// Las 8 islas con su forma real (src/data/mapa-islas.ts, compartido con el mapa de "Cómo pedir" desde el 13-nov).
// Tenerife en naranja con Los Majuelos marcado y una ruta de puntos hasta cada isla, que se dibuja una vez al cargar.
// Es decorativo (aria-hidden): el texto de al lado ya lo dice. Sin JavaScript se ve entero y quieto.
import { vistaIslas, tenerife, origen, islas, conRuta } from '../data/mapa-islas';

// nombres (16-nov-2026, Nosotros): el nombre de cada isla aparece cuando le llega su ruta. Posición respecto a su punto:
// [x, y, alineación]; los del este van a la izquierda para no salirse del dibujo.
interface Props { class?: string; nombres?: boolean }
const { class: clase = '', nombres = false } = Astro.props;
const posNombre: Record<string, [number, number, 'start' | 'middle' | 'end']> = {
  'La Gomera': [0, 17, 'middle'],
  'Gran Canaria': [21, 15, 'start'],
  'La Palma': [13, 3, 'start'],
  'El Hierro': [12, 4, 'start'],
  'Fuerteventura': [-11, 4, 'end'],
  'Lanzarote': [-11, 4, 'end'],
  'La Graciosa': [-10, 5, 'end'],
};
---
<svg viewBox={vistaIslas} aria-hidden="true" focusable="false" class:list={['mapa-reparto', clase]}>
  <defs>
    {/* Máscara que va descubriendo las rutas desde Tenerife hacia cada isla */}
    <mask id="mapa-reparto-rutas" maskUnits="userSpaceOnUse" x="-8" y="-8" width="416" height="174">
      {conRuta.map((i, n) => <path d={i.ruta} pathLength="1" class="ruta-trazo" style={`--r:${n}`} />)}
    </mask>
  </defs>
  {islas.map((i) => <path d={i.d} class="isla" />)}
  <g mask="url(#mapa-reparto-rutas)">
    {conRuta.map((i) => <path d={i.ruta} class="ruta" />)}
  </g>
  <path d={tenerife} class="isla-origen" />
  {conRuta.map((i, n) => <circle cx={i.fin[0]} cy={i.fin[1]} r={4.2 * ("punto" in i ? i.punto : 1)} class="destino" style={`--r:${n}`} />)}
  <circle cx={origen[0]} cy={origen[1]} r="11" class="origen-onda" />
  <circle cx={origen[0]} cy={origen[1]} r="5.4" class="origen" />
  {nombres && (
    <g class="nombres-islas">
      {/* Debajo de la isla: arriba lo cruzaban las rutas */}
      <text x={origen[0] - 20} y={origen[1] + 56} text-anchor="middle" class="isla-nombre isla-nombre-origen">Tenerife</text>
      {islas.map((i, n) => {
        const [dx, dy, ancla] = posNombre[i.nombre] ?? [8, 4, 'start'];
        return <text x={i.fin[0] + dx} y={i.fin[1] + dy} text-anchor={ancla} class="isla-nombre" data-isla={i.nombre} style={`--r:${n}`}>{i.nombre}</text>;
      })}
    </g>
  )}
</svg>
