---
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import BarraContacto from '../components/BarraContacto.astro';
import Efectos from '../components/Efectos.astro';
import { negocio, PUBLICADA } from '../data/negocio';
// La tipografía se pide lo primero (9-nov-2026): si llegan tarde, el texto se recoloca y la página "salta" en el móvil
import fuenteTexto from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

interface Props { titulo: string; descripcion: string; }
const { titulo, descripcion } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);

// Datos estructurados: solo datos reales y visibles en la web
const d = negocio.direccion;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: negocio.nombreCompleto,
  legalName: negocio.razonSocial,
  url: Astro.site?.href,
  logo: new URL('/logo-elnuba.png', Astro.site).href,
  telephone: negocio.telefonoE164,
  email: negocio.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${d.calle}, ${d.zona}`,
    postalCode: d.cp,
    addressLocality: d.localidad,
    addressRegion: d.provincia,
    addressCountry: 'ES',
  },
  areaServed: { '@type': 'State', name: 'Canarias' },
  sameAs: [negocio.instagram, negocio.facebook],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {!PUBLICADA && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#f2efe9" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL('/og-elnuba.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ELNUBA, mayorista de papelería en Tenerife" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    <!-- Efectos: se activan antes de pintar; si el script no llega a cargar, a los 2,5 s se muestra todo igualmente -->
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){var r=document.documentElement;if(!r.classList.contains('efectos-listos'))r.classList.remove('js');},2500);</script>
  </head>
  <body class="pb-16 md:pb-0">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido"><slot /></main>
    <Pie />
    <BarraContacto />
    <Efectos />
  </body>
</html>
