---
import { ruta } from '../lib/ruta';
import '../styles/global.css';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import BarraContacto from '../components/BarraContacto.astro';
import Efectos from '../components/Efectos.astro';
import ElegirCorreo from '../components/ElegirCorreo.astro';
import Consentimiento from '../components/Consentimiento.astro';
import { negocio, PUBLICADA, hayAnalitica, type TipoCorreo } from '../data/negocio';
import { grafo, type Servicio } from '../data/seo';
// La tipografía se pide lo primero (9-nov-2026): si llegan tarde, el texto se recoloca y la página "salta" en el móvil
import fuenteTexto from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';

// indexar: false en las legales y la 404 (como en aimanganell.com): no compiten en Google, pero sus enlaces sí cuentan.
// modificado: fecha AAAA-MM-DD de la última actualización, si la página la enseña (legales).
// servicio: el servicio principal de la página (Colegios, Empresas), de servicios en src/data/seo.ts
// tipo (16-nov-2026): AboutPage en Nosotros y ContactPage en Contacto; el resto, WebPage
// correo (16-nov-2026, máster): el correo ya escrito de la página (colegio, empresa…) para "Pedir presupuesto" de la barra
// de arriba y "Escribir" de la barra del móvil; antes abrían siempre el general, aunque la página fuera la de Colegios.
// sinCanonica (16-nov-2026, máster): la 404 no tiene dirección propia (se sirve en cualquier ruta que no exista), así que
// no lleva canónica ni og:url; antes apuntaban a /404/, una dirección que no existe.
interface Props { titulo: string; descripcion: string; indexar?: boolean; modificado?: string; servicio?: Servicio; tipo?: 'WebPage' | 'AboutPage' | 'ContactPage'; sinCanonica?: boolean; correo?: TipoCorreo; }
const { titulo, descripcion, indexar = true, modificado, servicio, tipo = 'WebPage', sinCanonica = false, correo = 'general' } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const absoluta = (r: string) => new URL(ruta(r), Astro.site).href;
const imagen = absoluta('/og-elnuba.jpg');

// Datos estructurados (13-nov-2026): grafo empresa + web + página, en src/data/seo.ts
const jsonld = grafo({ inicio: absoluta('/'), canonica: sinCanonica ? undefined : canonica.href, titulo, descripcion, logo: absoluta('/logo-elnuba.png'), imagen, url: absoluta, modificado, servicio, tipo });
const robots = !PUBLICADA ? 'noindex, nofollow' : indexar ? null : 'noindex, follow';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {!sinCanonica && <link rel="canonical" href={canonica} />}
    {robots && <meta name="robots" content={robots} />}
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    {/* Iconos (13-nov-2026): Google pide un múltiplo de 48 px; el .ico lo piden solos los navegadores; el de Apple, con fondo */}
    <link rel="icon" href={ruta('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" href={ruta('/favicon-192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#f2efe9" />
    <meta name="author" content={negocio.razonSocial} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={negocio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {!sinCanonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ELNUBA, distribución de papelería" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content="ELNUBA, distribución de papelería" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
    {/* Efectos: se activan antes de pintar; si el script no llega a cargar, a los 2,5 s se muestra todo igualmente */}
    <script is:inline>document.documentElement.classList.add('js');setTimeout(function(){var r=document.documentElement;if(!r.classList.contains('efectos-listos'))r.classList.remove('js');},2500);</script>
  </head>
  <body class="pb-20 md:pb-0">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2">Saltar al contenido</a>
    <Cabecera correo={correo} />
    <main id="contenido"><slot /></main>
    <Pie />
    <BarraContacto correo={correo} />
    {/* 17-nov-2026: aviso de cookies, solo si hay analítica puesta en negocio.ts (si no, no hay cookies que avisar) */}
    {hayAnalitica && <Consentimiento />}
    <Efectos />
    <ElegirCorreo />
  </body>
</html>
