---
// Contacto. 13-nov-2026, rehecha (Álvaro: "darle una vuelta" y "destacar que donde estamos es exacto en Avenida El
// Paso 43, Los Majuelos": allí están las oficinas, el almacén y la tienda al público; la de Candelaria es un extra).
// Orden: 1) teléfono y correo arriba, al lado del título (es a lo que viene la gente); 2) "Dónde estamos", lo grande
// de la página, con la dirección en letra de revista y el mapa; 3) Candelaria, más pequeña y sin recuadro.
// Antes: título con foto, dos tarjetas con iconos en círculos y las dos tiendas iguales (la dirección salía dos veces).
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Pendiente from '../components/Pendiente.astro';
import CopiarCorreo from '../components/CopiarCorreo.astro';
import MapaGoogle from '../components/MapaGoogle.astro';
import { negocio, tiendas, telHref, mailHref } from '../data/negocio';

const d = negocio.direccion;
const [majuelos, candelaria] = tiendas;
const [via] = d.calle.split(', ');                       // "Av. El Paso 43"
const [, calle, numero] = via.match(/^(.*\D)\s*(\d+)$/) ?? [, via, ''];
const comoLlegar = (t: string) => `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(t)}`;
// En Los Majuelos, todo en el mismo sitio (Álvaro, 13-nov-2026; la recogida de pedidos, 11-nov)
const aqui = ['Oficinas', 'Almacén', 'Tienda abierta al público', 'Recogida de pedidos'];
const flecha = 'M7 17 17 7 M9 7h8v8';
---
<Base
  titulo="Contacto · ELNUBA, papelería en Los Majuelos (La Laguna)"
  descripcion={`Llámanos al ${negocio.telefono} o escríbenos a ${negocio.email}. Estamos en ${d.calle}, ${d.zona}, ${d.cp} ${d.localidad}, Tenerife.`}>

  {/* 15-nov-2026 (Álvaro): ahora también con la franja de marcas, para que la primera pantalla sea como la de las demás */}
  <Encabezado
    miga="Contacto"
    antetitulo="Contacto"
    titulo="Llámanos o escríbenos"
    entradilla="Te preparamos el presupuesto, resolvemos tus dudas o te decimos si tenemos un artículo."
    botones={false}>
    {/* Teléfono y correo, a la vista nada más entrar. Toda la tarjeta se puede pulsar (el enlace la cubre) */}
    <div slot="lateral" class="grid h-full gap-3 md:gap-4 lg:grid-rows-[1fr_auto]">
      <div class="tarjeta-tel relative flex flex-col justify-between gap-10 rounded-[2rem] bg-naranja p-7 text-[#13203a] sm:p-9">
        <span class="flex items-start justify-between gap-4">
          <span class="text-xs font-bold tracking-[.2em] uppercase">Llámanos</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="tarjeta-flecha size-7 fill-none stroke-current stroke-2"><path d={flecha} /></svg>
        </span>
        <a href={telHref} class="tarjeta-enlace block text-[2.6rem] leading-none font-extrabold tracking-[-.045em] whitespace-nowrap tabular-nums sm:text-6xl lg:text-[2.9rem] xl:text-[3.5rem]">{negocio.telefono}</a>
      </div>
      <div class="bloque tarjeta-correo relative flex flex-col gap-4 p-7 sm:p-9">
        <span class="flex items-start justify-between gap-4">
          <span class="text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Escríbenos</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="tarjeta-flecha size-6 fill-none stroke-naranja-oscuro stroke-2"><path d={flecha} /></svg>
        </span>
        <a href={mailHref} class="tarjeta-enlace block text-lg font-bold break-words sm:text-2xl lg:text-[1.15rem] xl:text-2xl">{negocio.email}</a>
        <p class="text-sm leading-relaxed text-gris">Para pedir presupuesto, mándanos la lista con las cantidades, el nombre de tu centro o empresa y dónde quieres recibirlo.</p>
        <CopiarCorreo class="relative z-10" antes="¿No se abre tu correo?" direccion={false} />
      </div>
    </div>
  </Encabezado>

  {/* DÓNDE ESTAMOS: lo principal de la página. La dirección en grande y, al lado, el mapa (la chincheta cae al verlo) */}
  <section id={majuelos.id} class="mx-auto max-w-7xl scroll-mt-28 px-3 py-10 sm:px-4 md:px-6 md:py-20">
    <div class="bloque grid overflow-hidden lg:grid-cols-12">
      <div class="p-7 sm:p-10 lg:col-span-5 lg:p-12">
        <p class="antetitulo text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Dónde estamos</p>
        <h2 class="direccion-grande mt-6">{calle}<span class="text-naranja-vivo">{numero}</span></h2>
        <p class="mt-4 text-lg leading-relaxed text-gris">{d.zona}<br />{d.cp} {d.localidad} ({d.isla})</p>

        <p class="mt-9 text-xs font-bold tracking-[.2em] uppercase">Todo en el mismo sitio</p>
        <ul class="mismo-sitio mt-4">
          {aqui.map((a) => <li>{a}</li>)}
        </ul>

        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={comoLlegar(majuelos.mapa)} target="_blank" rel="noopener" class="btn-primario">
            Cómo llegar
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-2"><path d={flecha} /></svg>
            <span class="sr-only">(abre Google Maps en otra pestaña)</span>
          </a>
          <p class="text-gris">{negocio.horario ? negocio.horario.join(' · ') : <>Horario: <Pendiente texto="horario real (pregunta 8)" /></>}</p>
        </div>
        <ul class="mt-8 space-y-2 border-t border-linea pt-6 text-sm text-gris">
          {majuelos.extras.filter((e) => e !== 'Recogida de pedidos').map((e) => <li class="flex gap-2.5"><span aria-hidden="true" class="mt-[.45rem] size-1.5 shrink-0 rounded-full bg-naranja"></span>{e}</li>)}
        </ul>
      </div>
      <div class="relative min-h-[18rem] lg:col-span-7">
        <MapaGoogle consulta={majuelos.mapa} titulo={`Mapa: ${negocio.nombre}, ${d.calle}, ${d.zona}`} etiqueta={`${negocio.nombre} · ${via}`} zona="Polígono Los Majuelos" calle={calle.trim()} class="mapa-grande" />
      </div>
    </div>
  </section>

  {/* CANDELARIA: un extra. Sin recuadro, más pequeña y con su mapa en miniatura. Solo como tienda abierta al público
      (ni se pide ni se recoge allí: 11-nov-2026) */}
  <section id={candelaria.id} class="mx-auto max-w-7xl scroll-mt-28 px-3 pb-12 sm:px-4 md:px-6 md:pb-24">
    <div class="grid items-center gap-8 border-t border-tinta/15 pt-10 md:grid-cols-[1fr_20rem] md:gap-12 md:pt-12 lg:grid-cols-[1fr_26rem]">
      <div>
        <p class="text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Y además, en {candelaria.lugar}</p>
        <h2 class="mt-3 text-3xl md:text-4xl">{candelaria.nombre}</h2>
        <p class="mt-3 max-w-xl text-lg leading-relaxed text-gris">{candelaria.nota}</p>
        <p class="mt-5 leading-relaxed">{candelaria.direccion.join(' · ')}</p>
        <p class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href={`tel:${candelaria.telefonoE164}`} class="font-bold text-naranja-oscuro hover:underline">{candelaria.telefono}</a>
          <a href={comoLlegar(candelaria.mapa)} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-bold text-naranja-oscuro hover:underline">
            Cómo llegar
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 fill-none stroke-current stroke-2"><path d={flecha} /></svg>
            <span class="sr-only">(abre Google Maps en otra pestaña)</span>
          </a>
          <span class="text-gris">{candelaria.horario ? candelaria.horario.join(' · ') : <>Horario: <Pendiente /></>}</span>
        </p>
      </div>
      <MapaGoogle consulta={candelaria.mapa} titulo={`Mapa: ${candelaria.nombre}, ${candelaria.lugar}`} zona={candelaria.lugar} class="mapa-mini" />
    </div>
  </section>

  <section class="border-t border-linea">
    <div class="mx-auto max-w-7xl px-4 py-12 text-gris md:px-6">
      <p><strong class="text-tinta">{negocio.razonSocial}</strong> · CIF {negocio.cif}</p>
    </div>
  </section>
</Base>
