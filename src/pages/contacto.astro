---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Pendiente from '../components/Pendiente.astro';
import Tiendas from '../components/Tiendas.astro';
import CopiarCorreo from '../components/CopiarCorreo.astro';
import { negocio, telHref, mailHref } from '../data/negocio';

const d = negocio.direccion;
---
<Base
  titulo="Contacto · ELNUBA, papelería en Los Majuelos (La Laguna)"
  descripcion={`Llámanos al ${negocio.telefono} o escríbenos a ${negocio.email}. Estamos en ${d.calle}, ${d.zona}, ${d.cp} ${d.localidad}, Tenerife.`}>

  <Encabezado
    foto="/img/escribiendo.webp"
    fotoAlt="Una mano escribiendo con bolígrafo sobre un papel"
    marcas={false}
    miga="Contacto"
    antetitulo="Contacto"
    titulo="Llámanos o escríbenos"
    entradilla="Te preparamos el presupuesto, resolvemos tus dudas o te decimos si tenemos un artículo."
    botones={false} />

  <section class="relative mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-24">
    <div class="grid gap-5 md:grid-cols-2">
      <a href={telHref} class="group flex items-center gap-5 rounded-2xl bg-naranja p-7 text-tinta transition hover:bg-amarillo md:p-9">
        <span class="grid size-14 shrink-0 place-items-center rounded-full bg-tinta">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-amarillo stroke-2"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></svg>
        </span>
        <span>
          <span class="block font-semibold">Llámanos</span>
          <span class="block font-serif text-3xl font-medium sm:text-4xl">{negocio.telefono}</span>
        </span>
      </a>
      <a href={mailHref} class="group flex items-center gap-5 rounded-2xl bg-pizarra p-7 text-white transition hover:bg-tinta md:p-9">
        <span class="grid size-14 shrink-0 place-items-center rounded-full bg-white/10">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 fill-none stroke-amarillo stroke-2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
        </span>
        <span class="min-w-0">
          <span class="block font-semibold text-white/80">Escríbenos</span>
          <span class="block font-serif text-xl font-medium break-all sm:text-2xl">{negocio.email}</span>
        </span>
      </a>
    </div>
    <CopiarCorreo class="mt-5 md:text-right" antes="¿Al pulsar no se abre tu correo?" direccion={false} />

    <div class="mt-14 grid gap-10 md:grid-cols-3">
      <div>
        <h2 class="text-xl font-medium">Almacén y oficinas</h2>
        <p class="mt-3 leading-relaxed text-gris">{d.calle}<br />{d.zona}<br />{d.cp} {d.localidad}<br />{d.isla}</p>
      </div>
      <div>
        <h2 class="text-xl font-medium">Horario</h2>
        {negocio.horario
          ? <ul class="mt-3 leading-relaxed text-gris">{negocio.horario.map((h) => <li>{h}</li>)}</ul>
          : <p class="mt-3 text-gris"><Pendiente texto="horario real (pregunta 8)" /></p>}
      </div>
      <div>
        <h2 class="text-xl font-medium">Para pedir presupuesto</h2>
        <p class="mt-3 leading-relaxed text-gris">Mándanos la lista de artículos con las cantidades, el nombre de tu centro o empresa y dónde quieres recibirlo.</p>
      </div>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <h2 class="text-4xl font-medium tracking-tight md:text-5xl">Tiendas abiertas al público</h2>
      <p class="mt-4 max-w-2xl text-lg text-gris">En Los Majuelos y en Candelaria.</p>
      <div class="mt-10"><Tiendas /></div>
    </div>
  </section>

  <section class="border-t border-linea">
    <div class="mx-auto max-w-7xl px-4 py-12 text-gris md:px-6">
      <p><strong class="text-tinta">{negocio.razonSocial}</strong> · CIF {negocio.cif}</p>
    </div>
  </section>
</Base>
