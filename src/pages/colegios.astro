---
import Icono from '../components/Icono.astro';
import { ruta } from '../lib/ruta';
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Familias from '../components/Familias.astro';
import Preguntas from '../components/Preguntas.astro';
import LlamadaFinal from '../components/LlamadaFinal.astro';
import Pendiente from '../components/Pendiente.astro';
import Foto from '../components/Foto.astro';
import Lapices from '../components/Lapices.astro';
import CopiarCorreo from '../components/CopiarCorreo.astro';
import { negocio, listaIslas, correos } from '../data/negocio';
import { servicios } from '../data/seo';

const pasos = [
  { titulo: 'Mándanos la lista', texto: 'Por correo o por teléfono.' },
  { titulo: 'Te preparamos el presupuesto', texto: 'Artículo por artículo.' },
  { titulo: 'Lo llevamos al centro', texto: 'O lo recoges en Los Majuelos.' },
];

// 10-nov-2026: tres más (Álvaro: "más FAQ"), solo con datos confirmados
const preguntas = [
  { p: '¿Cómo les mando la lista de material del centro?', r: `Por correo a ${negocio.email}, adjunta o copiada en el mensaje, o por teléfono al ${negocio.telefono}. Te preparamos el presupuesto artículo por artículo.` },
  { p: '¿Suministran libros de texto?', r: 'Sí. Además de material escolar, de dibujo y de pintura, suministramos libros de texto a centros educativos.' },
  { p: '¿Nos llevan el material al centro?', r: 'Sí, te lo llevamos al centro. Si lo prefieres, también puedes recogerlo en nuestro almacén de Los Majuelos (La Laguna).' },
  { p: '¿Trabajan con colegios públicos y privados?', r: 'Sí, con los dos.' },
  { p: '¿Trabajan con colegios de todas las islas?', r: `Sí, con colegios de todas las islas Canarias: ${listaIslas}.` },
  { p: '¿Tienen libros infantiles y material de dibujo y pintura?', r: 'Sí, además de papel, cuadernos, escritura, archivo y agendas.' },
];
---
<Base
  titulo="Material escolar al por mayor para colegios de Canarias · ELNUBA"
  descripcion="Material escolar y libros de texto al por mayor para colegios públicos y privados de Canarias. Mándanos la lista y te preparamos el presupuesto."
  servicio={servicios.colegios}
  correo="colegio">

  <Encabezado
    correo="colegio"
    miga="Colegios"
    antetitulo="Colegios y centros educativos"
    titulo="Material escolar al por mayor para colegios"
    entradilla="Para colegios públicos y privados de todas las islas Canarias. Mándanos la lista de material de tu centro y te preparamos el presupuesto.">
    <div slot="lateral" class="h-full">
      {/* 13-nov-2026 (Álvaro: "más decorado"): lápices de colores que asoman por abajo (Lapices.astro).
          16-nov-2026 (máster): el "+35" y sus textos, con el mismo grosor que en el inicio, Empresas y Nosotros (aquí
          seguían con el grosor fino del estilo anterior) */}
      <div class="bloque relative flex h-full flex-col overflow-hidden text-tinta">
        <div class="lado-anios p-7 sm:p-9 lg:pt-11">
          <p class="flex items-end gap-4">
            <span class="text-[5.5rem] leading-[.78] font-extrabold tracking-[-.05em] whitespace-nowrap text-naranja-vivo">{negocio.anios ? <><span class="sr-only">Más de {negocio.anios}</span><span aria-hidden="true" class="mas">+</span><span aria-hidden="true" data-contar={negocio.anios} class="tabular-nums">{negocio.anios}</span></> : <Pendiente texto="XX" />}</span>
            <span class="pb-1 text-xl leading-tight font-bold">años en<br />el sector</span>
          </p>
          <div class="franjas trazo mt-5 h-1.5 w-28 rounded-full" data-revelar style="--i:10"></div>
          <p class="mt-5 text-xl leading-snug font-bold">Colegios públicos y privados confían en nosotros</p>
          <ul class="mt-4 space-y-2 text-gris">
            <li class="flex items-center gap-2.5"><span aria-hidden="true" class="size-1.5 rounded-full bg-naranja"></span>Material escolar</li>
            <li class="flex items-center gap-2.5"><span aria-hidden="true" class="size-1.5 rounded-full bg-naranja"></span>Libros de texto</li>
            <li class="flex items-center gap-2.5"><span aria-hidden="true" class="size-1.5 rounded-full bg-naranja"></span>Dibujo y pintura</li>
          </ul>
        </div>
        <Lapices class="mt-auto px-3 sm:px-5" />
      </div>
    </div>
  </Encabezado>

  {/* CÓMO TRABAJAMOS (13-nov-2026, Álvaro: "está bastante simple"): la lista de material del centro, que se va
      marcando. Título grande con "nos encargamos" pintado con subrayador (se pinta al verlo), la foto más grande y los
      tres pasos como casillas que se marcan una detrás de otra, como quien repasa la lista. Al final, el botón para
      mandarla. Sin JavaScript o con "reducir movimiento", todo marcado desde el principio. CSS: .lista-… en global.css.
      Antes: título, foto pequeña con un marco desplazado y tres números. */}
  <section class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-20">
    <h2 class="lista-titulo max-w-4xl">Nos mandas la lista y <span class="subrayador" data-al-ver>nos encargamos</span></h2>
    <div class="mt-10 grid gap-8 md:mt-14 lg:grid-cols-12 lg:gap-14">
      <figure class="relative aspect-[3/2] overflow-hidden rounded-[2rem] lg:col-span-5 lg:aspect-auto lg:min-h-[25rem]">
        {/* 17-nov-2026: antes, una niña dibujando. Se cambió porque se le veía la cara: la licencia CC0 permite usar la
            foto, pero no trae el permiso de la persona que sale, y con menores la ley es especialmente estricta */}
        <Foto src="/img/lapices-fila.webp" alt="Lápices de colores en fila, ordenados como un arcoíris, sobre una mesa de madera" width={960} height={632} sizes="(min-width: 1280px) 510px, (min-width: 1024px) 40vw, 100vw" class="absolute inset-0 size-full object-cover" />
      </figure>
      <div class="lg:col-span-7">
        <ol class="lista-pasos" data-al-ver>
          {pasos.map((paso, i) => (
            <li style={`--n:${i}`}>
              <svg class="lista-casilla" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
                <rect x="2" y="2" width="40" height="40" rx="10" class="lista-caja" />
                <path d="M11.5 23.2c2.3 2.1 4.5 4.4 6.9 7.1 3.9-6.2 8.5-11.7 14.3-16.7" pathLength="1" class="lista-tick" />
              </svg>
              <div>
                <h3 class="lista-paso">{paso.titulo}</h3>
                <p class="mt-1.5 text-lg leading-relaxed text-gris">{paso.texto}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center">
          <a href={correos.colegio} class="btn-primario">
            <Icono nombre="correo" />
            Mandar la lista por correo
          </a>
          <CopiarCorreo />
        </div>
      </div>
    </div>
  </section>

  {/* QUÉ SUMINISTRAMOS */}
  <section class="mx-auto max-w-7xl px-4 pb-10 md:px-6 md:pb-20">
    <Familias para="colegios" antetitulo="Para el colegio" titulo="Qué suministramos a los centros" />
  </section>

  <Preguntas preguntas={preguntas} titulo="Preguntas de los colegios" correo="colegio" etiqueta="Colegios" />

  <LlamadaFinal correo="colegio" titulo="¿Tienes ya la lista de material?" texto="Mándanosla y te preparamos el presupuesto del centro." />
</Base>
{/* El subrayador y las casillas se marcan cuando se ven: data-al-ver (Efectos.astro). Si el script no llega, todo se ve marcado */}
