---
import Icono from '../components/Icono.astro';
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Familias from '../components/Familias.astro';
import Preguntas from '../components/Preguntas.astro';
import LlamadaFinal from '../components/LlamadaFinal.astro';
import { negocio, listaIslas, correos, telHref } from '../data/negocio';
import MapaCanarias from '../components/MapaCanarias.astro';
import CajaPedido from '../components/CajaPedido.astro';
import { servicios } from '../data/seo';

// 16-nov-2026, tarde (Álvaro: "Un proveedor para toda tu oficina no me gustó nada"; "Trabajamos con" sí en contenido,
// no en la forma; "algo que dé profesionalidad, moderno, que se vea como un trabajo bien hecho"). Estilo "comercial pulido":
//  - Por qué: mosaico. Grande blanco (titular, frase, +35 años y botón), marino con el mapa de las islas (las rutas se
//    dibujan al verlo), y dos pequeños: entrega (naranja) y trato directo con el teléfono.
//    17-nov-2026 (aspecto visual): el bloque blanco tenía un hueco vacío en medio. Ahora lleva "todo en un pedido": una
//    caja de reparto en la que caen el archivador, los folios, los lápices y el cartucho (CajaPedido.astro).
//  - Trabajamos con: 18-nov-2026, filas como el índice de Nosotros (Álvaro eligió esta opción). Antes: carpetas naranja
//    y marino (17-nov) y un recuadro blanco partido en dos (18-nov, mañana); no gustaron. CSS: .indice… en global.css.
// Antes (16-nov, mañana): frases grandes con subrayador y un bloque marino con dos columnas de texto (no gustó).
// Solo datos confirmados (CLAUDE.md del cliente).
// 24-nov-2026: Gonzalo confirma que hacen factura electrónica a organismos públicos y a cualquier cliente que la
// necesite (pregunta 13). Sustituye al [PENDIENTE] que iba debajo de la fila de organismos.
const sectores = [
  {
    id: 'empresas', sector: 'Sector privado', num: '01', icono: 'M3 8h18v12H3z M8 8V5h8v3 M3 13h18 M11 13v2h2v-2', titulo: 'Empresas y despachos', texto: 'Para el día a día de tu oficina.',
    lista: ['Papel, archivo y escritura', 'Tóner y cartuchos', 'Libros jurídicos', 'Entrega en tu oficina', 'Factura electrónica'],
  },
  {
    id: 'organismos', sector: 'Sector público', num: '02', icono: 'M3 21h18 M5 21v-9 M9.5 21v-9 M14.5 21v-9 M19 21v-9 M2.5 10 12 4l9.5 6z', titulo: 'Organismos públicos', texto: 'Material de oficina para la administración pública de Canarias.',
    lista: ['Papel, archivo y escritura', 'Tóner y cartuchos', 'Entrega en tus oficinas', 'Factura electrónica'],
  },
];
const flecha = 'M5 12h14 M13 6l6 6-6 6';

// 10-nov-2026: tres más (Álvaro: "más FAQ"), solo con datos confirmados
const preguntas = [
  { p: '¿Cómo hago un pedido?', r: `Llámanos al ${negocio.telefono} o escríbenos a ${negocio.email} con lo que necesitas y te preparamos el presupuesto.` },
  { p: '¿Trabajan con la administración pública?', r: 'Sí. Suministramos material de oficina a organismos públicos de Canarias.' },
  // 24-nov-2026: confirmado por Gonzalo (pregunta 13)
  { p: '¿Hacen factura electrónica?', r: 'Sí. A organismos públicos y a cualquier empresa o cliente que la necesite.' },
  { p: '¿Me llevan el pedido a la oficina?', r: 'Sí, te lo llevamos a tu oficina. Si lo prefieres, también puedes recogerlo en nuestro almacén de Los Majuelos (La Laguna).' },
  { p: '¿Reparten a todas las islas?', r: `Sí, a todas las islas Canarias: ${listaIslas}.` },
  // 15-nov-2026: antes preguntaba por mobiliario, que no venden (Álvaro)
  { p: '¿Tienen tóner y cartuchos?', r: 'Sí. Consumibles de informática como tóner y cartuchos, además de papel, archivo y material de escritura.' },
  { p: '¿Tienen libros jurídicos?', r: 'Sí, para despachos y profesionales.' },
];
---
<Base
  titulo="Material de oficina para empresas y organismos de Canarias · ELNUBA"
  descripcion="Material de oficina, tóner y cartuchos para empresas, despachos y organismos públicos de Canarias. Te lo llevamos a la oficina."
  servicio={servicios.empresas}
  correo="empresa">

  {/* 24-nov-2026 (Álvaro): no le gustaron los clips ni dos tandas de fotos de banco. Imagen generada con ChatGPT a
      petición suya ("que sea bastante visual y acorde con nuestra página"): oficina luminosa con material en marino y
      naranja. Original en proyecto/imagenes-generadas. Se cambiará por una foto real cuando Álvaro haga las de ELNUBA */}
  <Encabezado
    foto="/img/empresas-oficina.webp"
    fotoAlt="Mesa de oficina con archivadores, folios, tóner, grapadora y bolígrafos"
    correo="empresa"
    miga="Empresas y organismos"
    antetitulo="Empresas, despachos y organismos públicos"
    titulo="Material de oficina para empresas y organismos públicos"
    entradilla="Papel, archivo, tóner y cartuchos para oficinas de todas las islas Canarias. Te lo llevamos a la oficina." />

  {/* POR QUÉ: mosaico (16-nov-2026, tarde) */}
  <section class="mx-auto max-w-7xl px-4 py-10 md:px-6 md:py-20">
    <div class="grid gap-3 md:gap-4 lg:grid-cols-12">
      <div class="bloque flex flex-col p-7 sm:p-10 lg:col-span-7 lg:p-12" data-al-ver="0.45">
        <p class="antetitulo self-start text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Por qué ELNUBA</p>
        <h2 class="mt-5 max-w-xl text-4xl leading-[1.02] tracking-[-.04em] sm:text-[clamp(2.3rem,4.4vw,3.7rem)]">Un proveedor para toda tu oficina</h2>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-gris">Papel, tóner y cartuchos, archivo y escritura: lo pides todo en un solo pedido y te llega todo junto.</p>
        <CajaPedido class="porque-caja" />
        <div class="flex flex-wrap items-end justify-between gap-6 border-t border-linea pt-7">
          {negocio.anios && (
            <p class="flex items-end gap-3">
              <span class="text-6xl leading-[.8] font-extrabold tracking-[-.05em] text-naranja-vivo md:text-7xl"><span class="sr-only">Más de {negocio.anios}</span><span aria-hidden="true" class="mas">+</span><span aria-hidden="true" data-contar={negocio.anios} class="tabular-nums">{negocio.anios}</span></span>
              <span class="leading-tight font-bold">años en<br />el sector</span>
            </p>
          )}
          <a href={correos.empresa} class="btn-primario">
            <Icono nombre="correo" />
            Pedir presupuesto
          </a>
        </div>
      </div>

      <div class="grid gap-3 md:gap-4 lg:col-span-5">
        <div class="zona-oscura mapa-oscuro flex flex-col justify-between gap-6 rounded-[2rem] p-7 sm:p-8" data-al-ver>
          <p class="text-xs font-bold tracking-[.2em] uppercase">Toda Canarias</p>
          <MapaCanarias class="mx-auto max-w-[15rem] sm:max-w-sm" />
          <p>
            <span class="block text-2xl leading-tight font-bold">Reparto a todas las islas</span>
            <span class="mt-1 block text-sm text-tinta/70">Desde Los Majuelos (La&nbsp;Laguna)</span>
          </p>
        </div>
        {/* 24-nov-2026 (móvil, "compáctalo"): Entrega y Trato directo, uno al lado del otro también en el móvil */}
        <div class="grid grid-cols-2 gap-3 md:gap-4">
          <div class="flex flex-col justify-between gap-6 rounded-[2rem] bg-naranja p-5 text-[#13203a] sm:gap-8 sm:p-7">
            <p class="text-xs font-bold tracking-[.2em] uppercase">Entrega</p>
            <p><span class="block text-xl leading-tight font-bold sm:text-2xl">En tu oficina</span><span class="mt-1 block text-sm">O recogida en Los Majuelos</span></p>
          </div>
          <div class="bloque flex flex-col justify-between gap-6 p-5 sm:gap-8 sm:p-7">
            <p class="text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Trato directo</p>
            <p><span class="block leading-snug font-bold">Te atiende quien conoce tu pedido</span><a href={telHref} class="toque mt-2 inline-block font-bold text-naranja-oscuro tabular-nums hover:underline">{negocio.telefono}</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* TRABAJAMOS CON (18-nov-2026). Álvaro eligió "filas como en Nosotros": el mismo índice de revista (.indice), con el
      número, el nombre grande, su frase y "Pedir presupuesto" (correo de empresa), y debajo lo que se les suministra
      separado por puntos naranjas, como el directorio de material. Al pasar el ratón la fila se aclara, igual que en
      Nosotros. Antes: dos carpetas naranja y marino (17-nov) y un recuadro blanco partido en dos (18-nov, mañana); no
      gustaron. Los id se mantienen (el inicio enlaza a #organismos). CSS: .indice… y .indice-lista en global.css */}
  <section class="mx-auto max-w-7xl px-4 pb-10 md:px-6 md:pb-20">
    <p class="antetitulo text-xs font-bold tracking-[.2em] text-naranja-oscuro uppercase">Trabajamos con</p>
    <h2 class="mt-3 max-w-3xl text-4xl md:text-5xl">Empresas, despachos y administración pública</h2>
    <ol class="indice mt-8 md:mt-12">
      {sectores.map((x) => (
        <li id={x.id} class="scroll-mt-2">
          <a href={correos.empresa} class="indice-fila">
            <span class="indice-num" aria-hidden="true">{x.num}</span>
            <span class="indice-nombre">{x.titulo}</span>
            <span class="indice-texto">{x.texto}</span>
            <span class="indice-enlace">
              Pedir presupuesto
              <svg aria-hidden="true" viewBox="0 0 24 24" class="indice-flecha size-5 fill-none stroke-current stroke-2"><path d={flecha} /></svg>
            </span>
            <span class="indice-lista">{x.lista.map((l) => <span>{l}</span>)}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {/* QUÉ SUMINISTRAMOS */}
  <section class="mx-auto max-w-7xl px-4 pb-10 md:px-6 md:pb-20">
    <Familias para="empresas" antetitulo="Para la oficina" titulo="Qué suministramos" />
  </section>

  <Preguntas preguntas={preguntas} titulo="Preguntas de empresas y organismos" correo="empresa" etiqueta="Empresas" />

  <LlamadaFinal correo="empresa" titulo="¿Qué necesita tu oficina?" texto="Cuéntanos lo que necesitas y te preparamos el presupuesto." />
</Base>
{/* Las rutas del mapa se dibujan cuando el mapa se ve: data-al-ver (Efectos.astro). Mientras, la animación espera parada
     (global.css, .mapa-oscuro); sin JavaScript o con "reducir movimiento", el mapa sale ya dibujado */}
