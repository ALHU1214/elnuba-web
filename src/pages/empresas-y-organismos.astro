---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import Familias from '../components/Familias.astro';
import Preguntas from '../components/Preguntas.astro';
import LlamadaFinal from '../components/LlamadaFinal.astro';
import Pendiente from '../components/Pendiente.astro';
import { negocio } from '../data/negocio';

const ventajas = [
  { titulo: 'Un solo proveedor', texto: 'Todo en un mismo pedido.' },
  { titulo: 'Entrega en tu oficina', texto: 'O recogida en Los Majuelos.' },
  { titulo: 'Toda Canarias', texto: 'Reparto a todas las islas.' },
  { titulo: 'Trato directo', texto: 'Te atiende quien conoce tu pedido.' },
];

const preguntas = [
  { p: '¿Trabajan con la administración pública?', r: 'Sí. Suministramos material de oficina a organismos públicos de Canarias.' },
  { p: '¿Cómo hago un pedido?', r: `Llámanos al ${negocio.telefono} o escríbenos a ${negocio.email} con lo que necesitas y te preparamos el presupuesto.` },
  { p: '¿Venden también mobiliario de oficina?', r: 'Sí, además de material de oficina y de archivo, ofimática y máquinas de oficina.' },
];
---
<Base
  titulo="Material de oficina para empresas y organismos públicos en Tenerife · ELNUBA"
  descripcion="Material de oficina, archivo, ofimática y mobiliario para empresas, despachos y organismos públicos de Tenerife y Canarias. Entrega en tu oficina. Pide presupuesto.">

  <Encabezado
    foto="/img/oficina-material.webp"
    fotoAlt="Grapadoras, portarrollos de celo, chinchetas y lapiceros sobre una mesa blanca"
    correo="empresa"
    miga="Empresas y organismos"
    antetitulo="Empresas, despachos y organismos públicos"
    titulo="Material de oficina para empresas y organismos públicos en Tenerife"
    entradilla="Papel, archivo, ofimática y mobiliario. Te lo llevamos a la oficina." />

  <!-- POR QUÉ -->
  <section class="relative mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
    <h2 class="max-w-2xl text-4xl font-medium tracking-tight md:text-5xl">Todo el material de tu oficina en un solo pedido</h2>
    <ul class="mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-4">
      {ventajas.map((v) => (
        <li class="border-t border-tinta/20 pt-6">
          <h3 class="text-lg font-semibold">{v.titulo}</h3>
          <p class="mt-2 leading-relaxed text-gris">{v.texto}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- EMPRESAS Y ORGANISMOS -->
  <section class="mx-auto grid max-w-7xl gap-6 px-4 pb-20 md:grid-cols-2 md:px-6 md:pb-28">
    <article id="empresas" class="scroll-mt-28 overflow-hidden rounded-2xl bg-white ring-1 ring-linea">
      <img src="/img/subrayadores.webp" alt="Rotuladores fluorescentes de colores" width="960" height="640" loading="lazy" decoding="async" class="aspect-[2/1] w-full object-cover" />
      <div class="p-7 md:p-9">
        <h2 class="text-2xl font-medium">Empresas y despachos</h2>
        <p class="mt-3 leading-relaxed text-gris">Material del día a día, máquinas, mobiliario y libros jurídicos.</p>
      </div>
    </article>
    <article id="organismos" class="scroll-mt-28 overflow-hidden rounded-2xl bg-white ring-1 ring-linea">
      <img src="/img/archivadores.webp" alt="Dos archivadores rojos" width="960" height="640" loading="lazy" decoding="async" class="aspect-[2/1] w-full object-cover" />
      <div class="p-7 md:p-9">
        <h2 class="text-2xl font-medium">Organismos públicos</h2>
        <p class="mt-3 leading-relaxed text-gris">Material de oficina para la administración pública en Canarias.</p>
        <p class="mt-3 text-gris"><Pendiente texto="¿facturación electrónica a la administración? (pregunta 13)" /></p>
      </div>
    </article>
  </section>

  <!-- QUÉ SUMINISTRAMOS -->
  <section>
    <div class="mx-auto max-w-7xl px-4 py-16 md:px-6 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="antetitulo text-xs font-bold tracking-[.24em] text-naranja-oscuro uppercase">Para la oficina</p>
          <h2 class="mt-3 text-4xl font-medium tracking-tight md:text-5xl">Qué suministramos</h2>
        </div>
      </div>
      <div class="mt-10"><Familias para="empresas" /></div>
    </div>
  </section>

  <Preguntas preguntas={preguntas} titulo="Preguntas de empresas y organismos" correo="empresa" />

  <LlamadaFinal correo="empresa" titulo="¿Qué necesita tu oficina?" texto="Cuéntanos lo que necesitas y te preparamos el presupuesto." />
</Base>
